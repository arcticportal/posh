{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "767c0ab3-32fb-af78-0fcc-7fa5c77220d5", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 12.0, "Coordinates": "POINT (11.92758793 78.9227865)", "Networks": ["SIOS"], "Start Year": 1993, "Site Name": "Ceilometer", "Web Links": ["https://sios-svalbard.org/node/60318"], "Site IDs": [60318], "Site Description": "Part of the BSRN network.", "Metadata Created": ["2021-07-28T11:17:16Z"], "Metadata Updated": ["2021-07-28T11:20:35Z"], "Contact Name": ["Marion Maturilli"], "Contact Email": ["Marion.Maturilli@awi.de"], "Organization": [], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;CLOUDS&gt;CLOUD PROPERTIES&gt;CLOUD BASE HEIGHT"], "Projects": [], "Project IDs": [6817.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "76d99425-c7a8-3f96-c4f1-1098f61e3837", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": -1040.0, "Coordinates": "POINT (13.93 76.43)", "Networks": ["SIOS"], "Start Year": 2016, "Site Name": "S1", "Web Links": ["https://sios-svalbard.org/node/908"], "Site IDs": [908], "Site Description": "The mooring S1, operational since June 2014, is located in the eastern Fram Strait, south-West offshore Svalbard region. Here, water masses, strongly influenced by the interaction between Atlantic and Arctic waters and by local atmospheric forcing, substantially contribute to driving the global thermohaline circulation. \r\n\r\nIn this region, there is remarkable variability in the system due to several forcing mechanisms (e.g., atmospheric, internal, tidal, and shelf dynamics) that play an important role, especially in the upper layer. On the contrary, it is not completely clear which processes are responsible for the inter-annual and seasonal deep flow variability in the western offshore Spitsbergen region. \r\n\r\nThe mooring S1 is specifically designed to collect ocean parameters (temperature, salinity, dissolved oxygen, turbidity, particulate flux, ocean currents) in the deep layer, covering approximately the last 150-250 m of the water column. From 2022 it collects data from 500m depth to the bottom.\r\n\r\nThe mooring was deployed for the first time in June 2014 in the framework of the Eurofleets project PREPARED. It is maintained by OGS and CNR-ISP (Italy), and since 2017 with the collaboration of the Italian Navy Hydrographic Institute. From 2022, S1 gained the contribution of the NATO CMRE, which implemented the observatory with more sensors to collect data in the Atlantic Water layer.", "Metadata Created": ["2020-09-04T15:23:06Z"], "Metadata Updated": ["2023-06-29T11:52:26Z"], "Contact Name": ["Manuel Bensi "], "Contact Email": ["mbensi@ogs.it"], "Organization": ["National Institute of Oceanography and applied Geophysics (OGS)"], "Related Locations": [], "Observed Properties": ["OCEANS&gt;OCEAN TEMPERATURE&gt;WATER TEMPERATURE", "OCEANS&gt;OCEAN CIRCULATION&gt;OCEAN CURRENTS", "OCEANS&gt;SALINITY/DENSITY&gt;CONDUCTIVITY", "OCEANS&gt;OCEAN CHEMISTRY&gt;OXYGEN", "OCEANS&gt;MARINE SEDIMENTS&gt;PARTICLE FLUX", "OCEANS&gt;OCEAN OPTICS&gt;TURBIDITY"], "Projects": [], "Project IDs": [10969.0], "Operating Status": "Operational", "Site Type": ["underwater platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "76ed9406-5cca-0d1e-9f64-0cbd5a137b5a", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 175.0, "Coordinates": "POINT (15.61258 77.03532)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "Automatic Weather Station - HANSBREEN", "Web Links": ["https://sios-svalbard.org/node/152400", "https://crios.pl/"], "Site IDs": [152400], "Site Description": "AWS is located on a glacier surface and is installed on a tripod.\r\nThe height of the temperature sensor is approximately 2 m above snow-free glacier surface.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2023-10-17T15:05:48Z"], "Metadata Updated": ["2023-10-17T15:51:41Z"], "Contact Name": ["Dariusz Ignatiuk"], "Contact Email": ["dariusz.ignatiuk@us.edu.pl"], "Organization": ["University of Silesia in Katowice, Faculty of Natural Sciences, Institute of Earth Sciences"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "ATMOSPHERE&gt;ATMOSPHERIC WATER VAPOR&gt;WATER VAPOR INDICATORS&gt;HUMIDITY&gt;RELATIVE HUMIDITY", "ATMOSPHERE&gt;ATMOSPHERIC WINDS&gt;SURFACE WINDS&gt;WIND SPEED", "ATMOSPHERE&gt;ATMOSPHERIC WINDS&gt;SURFACE WINDS&gt;WIND DIRECTION", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;INCOMING SOLAR RADIATION", "CRYOSPHERE&gt;SNOW/ICE&gt;ALBEDO"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (on ice)"]}
