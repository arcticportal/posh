{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "6b70612c-256e-5c42-28cb-9ccd89a5ff69", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": -20.0, "Coordinates": "POINT (22.299317 80.295563)", "Networks": ["SIOS"], "Start Year": 2006, "Site Name": "Kongsfjorden Rijpfjorden Observatory Programme (KROP) - Rijpfjorden Observatory", "Web Links": ["https://sios-svalbard.org/node/152388", "https://www.mare-incognitum.no/krop/"], "Site IDs": [152388], "Site Description": "Observatory moored with anchor weight. Bottom depth around 220 m. About 200 m of mooring line. Subsurface buoyancy at about 20 m water depth (hence the -20 m above sea level which refers to the start of the mooring line, not an actual instrument depth). Top 20 m left empty due to risk of ice scouring. Main &quot;photo&quot; is an example of a mooring diagram from 2021. Mooring setup is similar for other years, but does have changes in the details. Additional photos to illustrate some of the instrumentation.\r\nData is available at https://archive.sigma2.no/ split up according to years and sensor types.", "Metadata Created": ["2023-10-17T09:58:04Z"], "Metadata Updated": ["2023-10-17T14:34:46Z"], "Contact Name": ["Daniel Vogedes"], "Contact Email": ["daniel.vogedes@uit.no"], "Organization": ["UiT The Arctic University of Norway"], "Related Locations": [], "Observed Properties": ["OCEANS&gt;OCEAN TEMPERATURE&gt;WATER TEMPERATURE", "OCEANS&gt;SALINITY/DENSITY&gt;CONDUCTIVITY", "OCEANS&gt;SALINITY/DENSITY&gt;SALINITY", "OCEANS&gt;OCEAN OPTICS&gt;FLUORESCENCE", "OCEANS&gt;OCEAN OPTICS&gt;TURBIDITY", "OCEANS&gt;OCEAN ACOUSTICS&gt;AMBIENT NOISE", "OCEANS&gt;OCEAN ACOUSTICS&gt;ACOUSTIC SCATTERING", "OCEANS&gt;MARINE SEDIMENTS&gt;SEDIMENTATION"], "Projects": [], "Project IDs": [11106.0, 11107.0], "Operating Status": "Operational", "Site Type": ["sea platform (fixed)"]}
