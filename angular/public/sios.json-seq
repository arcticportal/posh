{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "663e6318-ffc7-a94c-3a52-8a7f6a29a5d3", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 26.0, "Coordinates": "POINT (11.83333552 78.92093835)", "Networks": ["SIOS"], "Start Year": 1998, "Site Name": "Bayelva site: Meteorology and Radiation", "Web Links": ["https://sios-svalbard.org/node/60315"], "Site IDs": [60315], "Site Description": "part of GTN-P", "Metadata Created": ["2021-07-28T10:55:10Z"], "Metadata Updated": ["2023-06-27T16:39:35Z"], "Contact Name": ["Julia Boike, Niko Bornemann"], "Contact Email": ["julia.boike@awi.de"], "Organization": ["Alfred Wegener Institute"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;SHORTWAVE RADIATION", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;LONGWAVE RADIATION", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;INCOMING SOLAR RADIATION", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;OUTGOING LONGWAVE RADIATION", "ATMOSPHERE&gt;ATMOSPHERIC WATER VAPOR&gt;WATER VAPOR INDICATORS&gt;HUMIDITY&gt;RELATIVE HUMIDITY", "CLIMATE INDICATORS&gt;CRYOSPHERIC INDICATORS&gt;SNOW DEPTH"], "Projects": [], "Project IDs": [2950.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "664df69e-e2ae-8e87-d013-98ccaa931129", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 0.0, "Coordinates": "POINT (11.74502211 78.94862724)", "Networks": ["SIOS"], "Start Year": 2012, "Site Name": "COAT_Temperature logger_1", "Web Links": ["https://sios-svalbard.org/node/893"], "Site IDs": [893], "Site Description": "40 loggers on Brøgger Peninsula", "Metadata Created": ["2020-09-04T13:37:33Z"], "Metadata Updated": ["2023-10-16T17:14:19Z"], "Contact Name": ["Åshild Ø. Pedersen"], "Contact Email": ["Ashild.Pedersen@npolar.no"], "Organization": ["Norwegian Polar Institute"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE"], "Projects": [], "Project IDs": [5974.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "66613c39-764f-8fab-7a8f-271a4cb82083", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": -75.0, "Coordinates": "POLYGON ((11.54 79.05, 12.4 78.91))", "Networks": ["SIOS"], "Start Year": 2014, "Site Name": "Underwater Soundscape Station", "Web Links": ["https://sios-svalbard.org/node/152382", "https://www.researchinsvalbard.no/project/20000000-0000-0000-0000-000000007210/project-info"], "Site IDs": [152382], "Site Description": "The two acoustic moorings (Position and depth: 79°03.219’ N - 11°32.830’E - 72 m 78° 54.743’ N - 12° 24.308’ E - 79 m), operational since May 2014, is located in the Kongsfjorden. The first mooring was located in the inner part of Kongsfjorden at a distance of approximately 4 km from the Kronebreen glacier front, one of the largest fast-flowing and actively calving marine-terminating glacier streams of the Svalbard Islands; the second mooring was located at the mouth of the fjord, 27 km away from the Kronebreen glacier.\r\nThe fjord oceanography is regulated by the mixing of melting ice, cold Arctic waters, and warmer Atlantic water masses. Actively calving marine-terminating glaciers supply icebergs and freshwater input, which, together with other physical factors, determine the local species composition. Glacier fronts are upwelling areas for zooplankton and attract many top predators. However, climate-induced changes in oceanographic conditions are significantly altering Kongsfjorden habitats. Tidewater glaciers in Kongsfjorden are retreating, and recently, during the wintertime, sea ice formed only in the inmost parts of the fjord.", "Metadata Created": ["2023-10-06T15:30:08Z"], "Metadata Updated": ["2023-10-10T15:49:54Z"], "Contact Name": ["Giuseppa Buscaino"], "Contact Email": ["giuseppa.buscaino@cnr.it"], "Organization": ["National Research Council of Italy"], "Related Locations": [], "Observed Properties": ["OCEANS&gt;OCEAN ACOUSTICS&gt;AMBIENT NOISE"], "Projects": [], "Project IDs": [6616.0], "Operating Status": "Operational", "Site Type": ["sea platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "66b4890d-2bb4-5b27-8a1d-f3ed81559d38", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 7.0, "Coordinates": "POINT (15.83465 78.20146)", "Networks": ["SIOS"], "Start Year": 1998, "Site Name": "GTN-P Old Auroral Station PYRN", "Web Links": ["https://sios-svalbard.org/node/654", "http://gtnpdatabase.org/boreholes/view/166/", "https://gtnpbase.org/"], "Site IDs": [654], "Site Description": "The borehole is located 2m west of the midpoint of the resistivity monitoring profile. The westernmost line of the UNISCALM grid is located 12m east of the borehole. Drilled in loess deposit\r\n\r\nLithology:\t0-1.2m: sand and some gravel; 1.2-3m: sand/silt/clay; 3-4m: clean ice (ice wedge or thick ice lens?); 4-6m: Mainly clay/silt; -10m: clay/silt, maybe some sand. Layered. Very low resistance during. Salinity at 10m is 11.8% (analysed by L.Hutchinson)", "Metadata Created": ["2020-02-17T11:30:01Z"], "Metadata Updated": ["2023-06-28T12:50:40Z"], "Contact Name": ["Hanne Hvidtfeldt Christiansen"], "Contact Email": ["hanne.christiansen@unis.no"], "Organization": ["The University Centre in Svalbard"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [], "Operating Status": "Closed", "Site Type": ["land platform (fixed)"]}
