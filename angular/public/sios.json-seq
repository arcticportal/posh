{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "630c606e-4e57-0c8b-739c-685e51ae1acb", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 200.0, "Coordinates": "POINT (16.37315 78.72663)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "Timelapse camera - SVENBREEN", "Web Links": ["https://sios-svalbard.org/node/153204", "https://crios.pl"], "Site IDs": [153204], "Site Description": "The camera is installed near the top of a rock threshold. The lens is pointed in a westerly direction, towards the Svenbreen margin.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2024-06-25T12:40:33Z"], "Metadata Updated": ["2024-06-25T12:40:33Z"], "Contact Name": ["Jakub Malecki"], "Contact Email": ["malecki.jk@gmail.com"], "Organization": ["Adam Mickiewicz University, Poland"], "Related Locations": [], "Observed Properties": ["CLIMATE INDICATORS&gt;CRYOSPHERIC INDICATORS&gt;SNOW COVER"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "63bfc90d-5b66-4d05-3771-ad783f01da99", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 5.0, "Coordinates": "POINT (11.824824 78.675242)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "STRING: thermistor string to measure ground temperature - Kaffiøyra", "Web Links": ["https://sios-svalbard.org/node/152415", "https://crios.pl/"], "Site IDs": [152415], "Site Description": "The borehole near the UMK station in Kaffioyra was located at the existing meteorological garden, about 100 m from the shoreline. The drilling was carried out on 20-21.07.2023. The substrate is dominated by loose sandy-gravel beach sediments. A large amount of fine material and the formation of a core in a small part of the hole made it possible to reach a depth of 10.0 m below sea level.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland \r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nAdditional contact persons: Ireneusz Sobota (irso@umk.pl), Dariusz Ignatiuk (dariusz.ignatiuk@us.edu.pl)\r\n\r\n* height above mean sea level to check", "Metadata Created": ["2023-10-19T16:24:31Z"], "Metadata Updated": ["2023-10-23T09:30:35Z"], "Contact Name": ["Krzysztof Senderak"], "Contact Email": ["krzysztof.senderak@uwr.edu.pl"], "Organization": ["University of Wrocław"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "6400c1b0-f610-35bd-d3a2-1972e35b464e", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 45.0, "Coordinates": "POINT (11.89423 78.91759)", "Networks": ["SIOS"], "Start Year": 2010, "Site Name": "Gruvebadet Air Sampler", "Web Links": ["https://sios-svalbard.org/node/60326"], "Site IDs": [60326], "Site Description": null, "Metadata Created": ["2021-07-28T13:20:39Z"], "Metadata Updated": ["2023-06-28T14:56:32Z"], "Contact Name": ["Rita Traversi"], "Contact Email": [" rita.traversi@unifi.it"], "Organization": ["National Research Council of Italy"], "Related Locations": ["Gruvebadet Atmosphere Laboratory"], "Observed Properties": ["ATMOSPHERE&gt;AEROSOLS&gt;AEROSOL PARTICLE PROPERTIES"], "Projects": [], "Project IDs": [3693.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "64bc1973-533f-097b-6cc7-787aa6ec8cd3", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 45.0, "Coordinates": "POINT (16.43878 78.68597)", "Networks": ["SIOS"], "Start Year": 2024, "Site Name": "SPICE: Autonomous snow depth station - PETUNIABUKTA", "Web Links": ["https://sios-svalbard.org/node/153235", "https://crios.pl"], "Site IDs": [153235], "Site Description": "Site Information https://a2photonicsensors.com/spice-snow-depth-real-time/\r\nSpice - IoT telemetric sensor for snowpack depth measurement.\r\nThe Spice sensor is a sonar-based sensor used for measuring the depth of the snowpack and monitoring its evolution during the winter season. The instrument performs temperature compensation so as to increase the accuracy of the measurement.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nSecond contact person: Michał Laska (michal.laska@us.edu.pl)", "Metadata Created": ["2024-10-01T15:58:58Z"], "Metadata Updated": ["2024-10-01T15:58:58Z"], "Contact Name": ["Jakub Malecki"], "Contact Email": ["malecki.jk@gmail.com"], "Organization": ["Adam Mickiewicz University, Poland"], "Related Locations": [], "Observed Properties": ["CLIMATE INDICATORS&gt;CRYOSPHERIC INDICATORS&gt;SNOW DEPTH"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (mobile)"]}
