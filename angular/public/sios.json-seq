{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "29778200-8f7a-f6ec-db6c-b02e65ac7ea0", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 14.0, "Coordinates": "POINT (11.977116 78.913971)", "Networks": ["SIOS"], "Start Year": 2019, "Site Name": "NORCE vegetation monitoring site 7", "Web Links": ["https://sios-svalbard.org/node/1019"], "Site IDs": [1019], "Site Description": "Vegetation type on site: Cassiope tetragona heath. \r\nPart of the project An automatic system for monitoring vegetation and environmental seasonal changes on Svalbard.", "Metadata Created": ["2020-12-29T12:31:46Z"], "Metadata Updated": ["2023-10-16T17:24:04Z"], "Contact Name": ["Bernt Johansen"], "Contact Email": ["bejo@norceresearch.no"], "Organization": ["NORCE"], "Related Locations": [], "Observed Properties": ["BIOSPHERE&gt;VEGETATION&gt;VEGETATION INDEX&gt;NORMALIZED DIFFERENCE VEGETATION INDEX (NDVI)", "AGRICULTURE&gt;SOILS&gt;SOIL MOISTURE/WATER CONTENT", "LAND SURFACE&gt;FROZEN GROUND&gt;SOIL TEMPERATURE", "SPECTRAL/ENGINEERING&gt;VISIBLE WAVELENGTHS&gt;VISIBLE IMAGERY", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "BIOSPHERE&gt;VEGETATION&gt;PHOTOSYNTHETICALLY ACTIVE RADIATION"], "Projects": [], "Project IDs": [11063.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "29fc0457-bee6-aba7-ca6a-2aa7cf037666", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 2.83, "Coordinates": "POINT (14.50072 77.56511)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "STRING: thermistor string to measure ground temperature - Calypsobyen", "Web Links": ["https://sios-svalbard.org/node/152416", "https://crios.pl/"], "Site IDs": [152416], "Site Description": "On the coastal section selected for drilling at Calypsobyen, the bedrock contains siltstone and sandstone forming relict abrasion platforms, which are currently covered by loose sand and gravel beach sediments. The borehole was located near the mouth of the Scott River (right bank), at a distance of about 75 m from the shoreline and 900 m from the station. After stopping the drilling progress again at 5 m below sea level, a decision was made to install a string in the third hole.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland \r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nAdditional contact persons: Piotr Zagórski (piotr.zagorski@mail.umcs.pl), Dariusz Ignatiuk (dariusz.ignatiuk@us.edu.pl)", "Metadata Created": ["2023-10-19T16:50:25Z"], "Metadata Updated": ["2023-10-23T09:44:02Z"], "Contact Name": ["Krzysztof Senderak"], "Contact Email": ["krzysztof.senderak@uwr.edu.pl"], "Organization": ["University of Wrocław"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "2b06ed2a-6d67-b2a0-4f93-507312ecd9a0", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 10.0, "Coordinates": "POINT (11.93007 78.92346)", "Networks": ["SIOS"], "Start Year": 2020, "Site Name": "Pandora, Sverdrup Station, Ny-Ålesund", "Web Links": ["https://sios-svalbard.org/node/741", "https://www.pandonia-global-network.org/"], "Site IDs": [741], "Site Description": null, "Metadata Created": ["2020-03-25T15:17:58Z"], "Metadata Updated": ["2023-10-16T17:24:58Z"], "Contact Name": ["Ann Mari Fjæraa"], "Contact Email": ["ann.mari.fjaeraa@nilu.no"], "Organization": ["Norwegian Institute for Air Research"], "Related Locations": ["Sverdrup"], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC CHEMISTRY&gt;NITROGEN COMPOUNDS&gt;CLOUD-SCREENED TOTAL COLUMN NITROGEN DIOXIDE (NO2)"], "Projects": [], "Project IDs": [10137.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "2bb2e092-2521-15f4-c2e1-1636dc106bd2", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 0.0, "Coordinates": "POINT (15.83350896 78.20281863)", "Networks": ["SIOS"], "Start Year": 2018, "Site Name": "NIVA&#039;s Adventelva River Monitoring Infrastructure", "Web Links": ["https://sios-svalbard.org/node/153114"], "Site IDs": [153114], "Site Description": "From 2020 the sensors are mounted on a kayak that is anchored in the river a bit upstream the flight wreck (heritage site) near the &quot;Old Aurora station&quot; of UNIS.\r\nFrom the beginning in July 2017 until end of September 2019 the station was located at 78 12.233N 015 49.703E. During that period all sensors had been mounted in one fixture that was pushed down into a pipe that was mounted with a descent down into the water on a rigid construction in the river.", "Metadata Created": ["2024-02-14T11:14:51Z"], "Metadata Updated": ["2024-09-03T13:03:27Z"], "Contact Name": ["Uta Brandt"], "Contact Email": ["uta.brandt@niva.no"], "Organization": ["Norwegian Institute for Water Research"], "Related Locations": [], "Observed Properties": ["TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;WATER TEMPERATURE", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;CONDUCTIVITY", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;pH", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;TURBIDITY", "TERRESTRIAL HYDROSPHERE&gt;SURFACE WATER&gt;SURFACE WATER PROCESSES/MEASUREMENTS&gt;WATER DEPTH"], "Projects": [], "Project IDs": [10726.0], "Operating Status": "Operational", "Site Type": ["lake/river platform (fixed)"]}
