{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "eb8e8eaa-78e7-b679-6bf4-a155e144c22a", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 12.0, "Coordinates": "POINT (15.925809 78.18533)", "Networks": ["SIOS"], "Start Year": 2020, "Site Name": "Hyperspectral spectrometer (FLOX-Ocean Optics).", "Web Links": ["https://sios-svalbard.org/node/657", "http://www.nina.no"], "Site IDs": [657], "Site Description": "The hyperspectral spectrometer (FLOX-Ocean Optics) at the EddyCovariance facility (carbonflux\r\ntower) in Adventdalen will give time-series of very detailed spectral properties (spectral resolution\r\n&lt;1 nm) included sun induced fluorescence (of vegetation which will be used for calibration of NDVI-sensors\r\nin Adventdalen. The project (SIOS Instrument #49) is part of the Svalbard Integrated Arctic Earth Observing\r\nSystem and is approved by Longyearbyen lokalstyre.", "Metadata Created": ["2020-02-17T14:41:26Z"], "Metadata Updated": ["2023-10-16T17:17:24Z"], "Contact Name": ["Hans Tømmervik"], "Contact Email": ["hans.tommervik@nina.no"], "Organization": ["Norwegian Institute for Nature Research"], "Related Locations": [], "Observed Properties": ["LAND SURFACE&gt;SURFACE RADIATIVE PROPERTIES&gt;REFLECTANCE"], "Projects": [], "Project IDs": [11326.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "ebd5a227-ffe1-9ac0-e711-d7171774f2d3", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 25.0, "Coordinates": "POINT (11.870164 78.925627)", "Networks": ["SIOS"], "Start Year": 2019, "Site Name": "NORCE vegetation monitoring site 4", "Web Links": ["https://sios-svalbard.org/node/1016"], "Site IDs": [1016], "Site Description": "Vegetation type on site: Saxifraga oppositifolia dry heath.\r\nPart of the project An automatic system for monitoring vegetation and environmental seasonal changes on Svalbard.", "Metadata Created": ["2020-12-29T12:25:34Z"], "Metadata Updated": ["2023-10-16T17:22:38Z"], "Contact Name": ["Bernt Johansen"], "Contact Email": ["bejo@norceresearch.no"], "Organization": ["NORCE"], "Related Locations": [], "Observed Properties": ["BIOSPHERE&gt;VEGETATION&gt;VEGETATION INDEX&gt;NORMALIZED DIFFERENCE VEGETATION INDEX (NDVI)", "AGRICULTURE&gt;SOILS&gt;SOIL MOISTURE/WATER CONTENT", "LAND SURFACE&gt;FROZEN GROUND&gt;SOIL TEMPERATURE", "SPECTRAL/ENGINEERING&gt;VISIBLE WAVELENGTHS&gt;VISIBLE IMAGERY", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "BIOSPHERE&gt;VEGETATION&gt;PHOTOSYNTHETICALLY ACTIVE RADIATION"], "Projects": [], "Project IDs": [11063.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "ed5c7650-becd-7a30-1c88-98f62655e9c4", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 65.0, "Coordinates": "POINT (14.2024 78.0907)", "Networks": ["SIOS"], "Start Year": 2016, "Site Name": "GTN-P Barentsburg Borehole 12", "Web Links": ["https://sios-svalbard.org/node/647", "http://gtnpdatabase.org/boreholes/view/1839/", "https://gtnpbase.org/"], "Site IDs": [647], "Site Description": "The system of long - term permafrost observations was organized on the permafrost site of Russian Scientific Center on Spitsbergen in summer 2016 (Demidov et al., 2016). The monitoring site is established in the vicinity of the mining settlement Barentsburg on a sequence of Holocene marine terraces. The core drilling showed that the thickness of gravel sands and clays with massive and schlieren cryostructure forming the accumulative terraces is of 2 – 7 m. \r\n\r\nBorehole is situated on a flat subhorizontal surface (inclination 2 ° to the NW) of top step of stairs of marine terraces in the vicinity of Barentsburg aerodrom, 95 m a.s.l.. Surface of terrace around drill point has ill-defined pattern structure. Soil is covered by plant cover (~80% of square) or by rocks (~20% of square).  Also near to borehole there were remains of wood and metal tubes which had been used for drilling. In 2017 this remains were cleared away. Geological crossection is represented by fractured sandstone and mudstone overlaid by 2 m of gravelly loam with rocks. This borehole dates by early thirties of XX century when core drilling in the vicinity of Barentsburg was made for the purpose of coal exploration.", "Metadata Created": ["2020-02-17T09:40:30Z"], "Metadata Updated": ["2023-06-28T12:37:32Z"], "Contact Name": ["Sarah Strand"], "Contact Email": ["sarah.strand@unis.no"], "Organization": ["The University Centre in Svalbard"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
