{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "781f1671-1694-d5f9-8572-e88ee384a12d", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 323.0, "Coordinates": "POLYGON ((16.365 78.1828, 16.3876 78.18, 16.3815 78.1746, 16.3552 78.1742, 16.3451 78.1794, 16.365 78.1828))", "Networks": ["SIOS"], "Start Year": 1992, "Site Name": "Spits Seismic Array​ (SPITS)", "Web Links": ["https://sios-svalbard.org/node/152372", "http://eida.geo.uib.no​", "https://doi.org/10.21348/d.no.0001"], "Site IDs": [152372], "Site Description": "Seismic array consisting of​ 9 seismometers (SPA0,  SPA1, SPA2 , SPA3  , SPB1, SPB2, SPB3,  SPB4, SPB5) .\r\nSPITS is an auxiliary seismic array (AS72) in the IMS International Monitoring System (IMS) which is designed to detect any nuclear explosion conducted on Earth, to verify compliance with the Treaty​\r\nCoordinates of the array elements can be found at: https://www.norsar.no/data/norsar-station-network", "Metadata Created": ["2023-09-11T08:22:14Z"], "Metadata Updated": ["2023-09-11T08:24:24Z"], "Contact Name": ["Jon Magnus Christensen"], "Contact Email": ["Jon@norsar.no"], "Organization": ["NORSAR"], "Related Locations": [], "Observed Properties": ["SOLID EARTH&gt;TECTONICS&gt;EARTHQUAKES"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "7a94f926-e41d-c6e0-69dc-40420e3d7d54", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 40.0, "Coordinates": "POINT (15.7816 78.1902)", "Networks": ["SIOS"], "Start Year": 2008, "Site Name": "GTN-P Endalen PYRN", "Web Links": ["https://sios-svalbard.org/node/652", "http://gtnpdatabase.org/boreholes/view/63/", "https://gtnpbase.org/"], "Site IDs": [652], "Site Description": "Permafrost borehole in Endalen in Spitsbergen.\r\n\r\nLithology:\t0-1.5m: Diamicton. High fraction of fine material and scattered blocks; 1.5-2m: Coarser material. Ice lenses (10-20cm); 2-4m: Diamicton with blocks and finer material (silt/clay). Some ice lenses (3-4cm thick); -5m: Diamicton. Drier than above from 4.5m; 5-6m: Transition to bedrock. Crushed zone; 6-20m: Bedrock. Solid from 7.7m.", "Metadata Created": ["2020-02-17T10:55:28Z"], "Metadata Updated": ["2023-06-28T12:40:09Z"], "Contact Name": ["Hanne Hvidtfeldt Christiansen"], "Contact Email": ["hanne.christiansen@unis.no"], "Organization": ["The University Centre in Svalbard"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [], "Operating Status": "Closed", "Site Type": ["land platform (fixed)"]}
