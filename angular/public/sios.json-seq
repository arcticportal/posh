{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "8ed7b7a5-9388-516c-375d-a4eb844c106c", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": -20.0, "Coordinates": "POINT (11.84129 78.956863)", "Networks": ["SIOS"], "Start Year": 2006, "Site Name": "Kongsfjorden Rijpfjorden Observatory Programme (KROP) - Kongsfjorden Observatory", "Web Links": ["https://sios-svalbard.org/node/885", "https://www.mare-incognitum.no/krop/"], "Site IDs": [885], "Site Description": "Observatory moored with anchor weight. Bottom depth around 220 m. About 200 m of mooring line. Subsurface buoyancy at about 20 m water depth (hence the -20 m above sea level which refers to the start of the mooring line, not an actual instrument depth). Top 20 m left empty due to risk of ice scouring. Main &quot;photo&quot; is an example of a mooring diagram. Mooring setup is similar for other years, but does have changes in the details. Additional photos to illustrate some of the instrumentation.\r\nData is available at https://archive.sigma2.no/ split up according to years and sensor types.", "Metadata Created": ["2020-07-16T12:23:10Z"], "Metadata Updated": ["2025-11-03T17:16:00Z"], "Contact Name": ["Daniel Vogedes"], "Contact Email": ["daniel.vogedes@uit.no"], "Organization": ["UiT The Arctic University of Norway"], "Related Locations": [], "Observed Properties": ["OCEANS&gt;SALINITY/DENSITY&gt;CONDUCTIVITY", "OCEANS&gt;OCEAN TEMPERATURE&gt;WATER TEMPERATURE", "OCEANS&gt;MARINE SEDIMENTS&gt;SEDIMENTATION", "OCEANS&gt;OCEAN ACOUSTICS&gt;ACOUSTIC SCATTERING", "OCEANS&gt;SALINITY/DENSITY&gt;SALINITY", "OCEANS&gt;OCEAN ACOUSTICS&gt;AMBIENT NOISE", "OCEANS&gt;OCEAN OPTICS&gt;TURBIDITY"], "Projects": [], "Project IDs": [11107.0, 11106.0], "Operating Status": "Operational", "Site Type": ["sea platform (fixed)"]}
