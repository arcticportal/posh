{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "bd070baf-2ad2-57e2-0555-b8c4dcee42ed", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 50.0, "Coordinates": "POINT (16.286494 78.335175)", "Networks": ["SIOS"], "Start Year": 1991, "Site Name": "De Geerdalen station", "Web Links": ["https://sios-svalbard.org/node/753"], "Site IDs": [753], "Site Description": "It covers a catchment area of 79.1 km² of which 10 % consists of glaciers. The monitoring station is placed in a narrow gorge in part of a waterfall (Hyperitfossen) with a stable rock profile, close to the river outlet.", "Metadata Created": ["2020-03-31T17:03:47Z"], "Metadata Updated": ["2023-06-28T11:06:26Z"], "Contact Name": ["Kjetil Melvold"], "Contact Email": ["kjme@nve.no"], "Organization": ["Norwegian Water Resources and Energy Directorate"], "Related Locations": [], "Observed Properties": ["TERRESTRIAL HYDROSPHERE&gt;SURFACE WATER&gt;SURFACE WATER PROCESSES/MEASUREMENTS&gt;RUNOFF", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;WATER TEMPERATURE", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;SOLIDS&gt;SUSPENDED SOLIDS", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;ORGANIC MATTER", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;CONDUCTIVITY"], "Projects": [], "Project IDs": [1668.0, 11353.0], "Operating Status": "Operational", "Site Type": ["lake/river platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "bd3add79-5d2b-22c8-3007-321830da5663", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 42.0, "Coordinates": "POINT (11.86431 78.92966)", "Networks": ["SIOS"], "Start Year": 2013, "Site Name": "Cavity Ring-Down Spectroscopy", "Web Links": ["https://sios-svalbard.org/node/1033"], "Site IDs": [1033], "Site Description": null, "Metadata Created": ["2020-12-30T11:09:00Z"], "Metadata Updated": ["2023-06-28T10:49:46Z"], "Contact Name": ["Daisuke Goto"], "Contact Email": ["goto.daisuke@nipr.ac.jp "], "Organization": ["National Institute for Polar Research"], "Related Locations": ["Rabben"], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC CHEMISTRY&gt;CARBON AND HYDROCARBON COMPOUNDS&gt;CARBON DIOXIDE", "ATMOSPHERE&gt;ATMOSPHERIC CHEMISTRY&gt;CARBON AND HYDROCARBON COMPOUNDS&gt;METHANE", "ATMOSPHERE&gt;ATMOSPHERIC CHEMISTRY&gt;CARBON AND HYDROCARBON COMPOUNDS&gt;CARBON MONOXIDE"], "Projects": [], "Project IDs": [10027.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "be990601-ad2c-6098-6e97-207d70e57f3b", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 12.0, "Coordinates": "POINT (11.835 78.9325)", "Networks": ["SIOS"], "Start Year": 1989, "Site Name": "Bayelva station", "Web Links": ["https://sios-svalbard.org/node/766"], "Site IDs": [766], "Site Description": "Bayelva is situated on Brøggerhalvøya, due west of Ny-Ålesund. The catchment area is 30.9 km² of which 54 % is covered by the glaciers Austre Brøggerbreen and Vestre Brøggerbreen. In 1988 NVE initiated the discharge measurements and the river profile of Bayelva was stabilised by a large compound crump weir, designed and built by NVE. The cost was about 1 million Norwegian 1988-kroner. As the river profile is constantly changing there followed several problems, mainly due to the large amounts of sediment and ice build-up, but most were solved the following year.\r\nThe main problems with the runoff measurements are connected to ice and snow blocking the weir at the beginning of the snowmelt season (Fig. 14), leading to errors in calculation of river discharge. This is corrected for as far as possible, but the resulting accuracy is not known precisely.", "Metadata Created": ["2020-04-15T15:39:58Z"], "Metadata Updated": ["2023-10-16T17:10:40Z"], "Contact Name": ["Harald Songe"], "Contact Email": ["haso@nve.no"], "Organization": ["Norwegian Water Resources and Energy Directorate"], "Related Locations": [], "Observed Properties": ["TERRESTRIAL HYDROSPHERE&gt;SURFACE WATER&gt;SURFACE WATER PROCESSES/MEASUREMENTS&gt;RUNOFF", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;WATER TEMPERATURE", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;CONDUCTIVITY", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;SOLIDS&gt;SUSPENDED SOLIDS", "TERRESTRIAL HYDROSPHERE&gt;WATER QUALITY/WATER CHEMISTRY&gt;WATER CHARACTERISTICS&gt;ORGANIC MATTER"], "Projects": [], "Project IDs": [1668.0, 11353.0], "Operating Status": "Operational", "Site Type": ["lake/river platform (fixed)"]}
