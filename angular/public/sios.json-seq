{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "124714a1-fa5c-f044-f431-c98469f40d30", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 175.0, "Coordinates": "POINT (16.36971 78.72686)", "Networks": ["SIOS"], "Start Year": 2024, "Site Name": "Automatic Weather Station - SVENBREEN FRONT", "Web Links": ["https://sios-svalbard.org/node/153234", "https://crios.pl"], "Site IDs": [153234], "Site Description": "The weather station (AWS) is located near the margin of Svenbreen.", "Metadata Created": ["2024-10-01T13:10:41Z"], "Metadata Updated": ["2024-10-01T13:10:41Z"], "Contact Name": ["Jakub Malecki"], "Contact Email": ["malecki.jk@gmail.com"], "Organization": ["Adam Mickiewicz University, Poland"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Partly operational", "Site Type": ["land platform (mobile)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "12eda7a8-a9f9-8661-dada-d281bdc61128", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 19.0, "Coordinates": "POINT (14.5135 77.5583)", "Networks": ["SIOS"], "Start Year": 1986, "Site Name": "Weather Station UMCS-1 -  CALYPSOBYEN", "Web Links": ["https://sios-svalbard.org/node/152407"], "Site IDs": [152407], "Site Description": "Meteorological observations have been carried out since 1986 during summer Polar Expedition organized by Maria Curie-Sklodowska University. Until 1998, these observations were conducted using analog methods, which included the use of mercury thermometers inside instrument shelters. Since 1999, automatic weather stations (AWS) have been employed. Depending on the type of station, various meteorological parameters were recorded. In general, the following variables were monitored: air temperature at 2 meters above ground, humidity, atmospheric pressure, wind speed and direction, precipitation, solar radiation, and ground temperature (at ground level).\r\nAWS units were installed either on meteorological masts or on aluminum tripods.\r\n\r\n2022-2023 - AWS is installed on an aluminum tripod.\r\nThe temperature sensors are positioned at a height of approximately 2 meters above the land surface.\r\n\r\nProject “Autonomous quasi-distributed optical fiber temperature sensor for ground temperature measurements” (SPILOD), as part of the Smart Growth Operational Programme 2014-2020 3/4.1.1/2019 Joined Venture named “Lublin Upland of Photonic Technologies” implemented by the National Centre for Research and Development.\r\nProject period: 01.01.2021 - 31.12.2023 (2029)", "Metadata Created": ["2023-10-18T17:13:27Z"], "Metadata Updated": ["2023-10-21T11:22:34Z"], "Contact Name": ["Piotr Zagórski"], "Contact Email": ["piotr.zagorski@mail.umcs.pl"], "Organization": ["Maria Curie-Skłodowska University in Lublin"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "ATMOSPHERE&gt;ATMOSPHERIC PRESSURE&gt;ATMOSPHERIC PRESSURE MEASUREMENTS", "ATMOSPHERE&gt;ATMOSPHERIC WINDS&gt;SURFACE WINDS", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;SOLAR RADIATION", "ATMOSPHERE&gt;PRECIPITATION&gt;PRECIPITATION RATE", "ATMOSPHERE&gt;ATMOSPHERIC WATER VAPOR&gt;WATER VAPOR INDICATORS&gt;HUMIDITY&gt;RELATIVE HUMIDITY"], "Projects": [], "Project IDs": [11672.0, 12193.0, 11620.0, 11363.0, 10165.0, 6784.0, 4981.0, 1169.0, 951.0, 3918.0, 5762.0], "Operating Status": "Partly operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "138169c7-5fd9-c9f1-0168-d141330fd776", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 250.0, "Coordinates": "POINT (15.63444 77.05627)", "Networks": ["SIOS"], "Start Year": 1988, "Site Name": "Hansbreen mass balance stake network", "Web Links": ["https://sios-svalbard.org/node/751", "http://dx.doi.org/10.5904/wgms-fog-2018-11"], "Site IDs": [751], "Site Description": "Hansbreen surface mass balance monitoring programme started in 1988 on the initiative of the University of Silesia in Katowice. Since the beginning of XXi century programme is run under the umbrella of Polish Polar Station Hornsund owned by IG PAS. Hansbreen (HAB) is a medium-sized (56 km2) tidewater glacier located in the southern part of Wedel Jarlsberg Land, close to the Polish Polar Station in the fjord Hornsund. The glacier is ~16 km long, and elevations extend up to 550 m a.s.l. Surface mass balance monitoring started in 1988/89. Over the period of 1989-2017, the net surface mass balance has been continuously decreasing, with a mean of -0.36 m w.e. a-1. Frontal ablation, measured along the c. 1.5 km long ice cliff shows that mass loss by calving contributes substantially to the total mass loss (23-50%, i.e. additional ablation by an equivalent of c. -0.7 m w.e. a-1 on average) and varies interannually. SMB data are reported on a yearly basis to the World Glacier Monitoring Service.", "Metadata Created": ["2020-03-30T18:58:11Z"], "Metadata Updated": ["2023-06-27T16:14:05Z"], "Contact Name": ["Bartłomiej Luks"], "Contact Email": ["luks@igf.edu.pl"], "Organization": ["Institute of Geophysics, Polish Academy of Sciences"], "Related Locations": ["Polish Polar Station"], "Observed Properties": ["CRYOSPHERE&gt;GLACIERS/ICE SHEETS&gt;GLACIER MASS BALANCE/ICE SHEET MASS BALANCE"], "Projects": [], "Project IDs": [11500.0], "Operating Status": "Operational", "Site Type": ["land platform (on ice)"]}
