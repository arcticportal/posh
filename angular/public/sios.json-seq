{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "2f3c1a55-25dc-1555-4d2e-85ee9965957d", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 350.0, "Coordinates": "POINT (16.3004 78.72723)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "SPICE: Autonomous snow depth and glacier ablation station - SVENBREEN_1", "Web Links": ["https://sios-svalbard.org/node/153203", "https://crios.pl"], "Site IDs": [153203], "Site Description": "Site Information https://a2photonicsensors.com/spice-snow-depth-real-time/\r\nSpice - IoT telemetric sensor for snowpack depth measurement.\r\nThe Spice sensor is a sonar-based sensor used for measuring the depth of the snowpack and monitoring its evolution during the winter season. The instrument performs temperature compensation so as to increase the accuracy of the measurement.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2024-06-25T12:24:40Z"], "Metadata Updated": ["2024-06-25T12:26:25Z"], "Contact Name": ["Jakub Malecki"], "Contact Email": ["malecki.jk@gmail.com"], "Organization": ["Adam Mickiewicz University, Poland"], "Related Locations": [], "Observed Properties": ["CLIMATE INDICATORS&gt;CRYOSPHERIC INDICATORS&gt;SNOW DEPTH"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (on ice)"]}
