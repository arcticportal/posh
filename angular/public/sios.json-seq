{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "55ec4062-9176-1b9e-6ae0-b8b24a47b4bd", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 275.0, "Coordinates": "POINT (16.4666 78.1833)", "Networks": ["SIOS"], "Start Year": 1998, "Site Name": "GTN-P Janssonhaugen P10", "Web Links": ["https://sios-svalbard.org/node/653", "http://gtnpdatabase.org/boreholes/view/501/"], "Site IDs": [653], "Site Description": "The Norwegian PACE boreholes (Janssonhaugen Svalbard and Juvvasshøe southern Mainland Norway) are taken care of by Dr. Ketil Isaksen, so also for the coming years. He serves the dataloggers and collects the data.  The data are stored at the Norwegian Meteorological Institute (met.no). ​ \r\n\r\nLithology:\tSand-/siltstone", "Metadata Created": ["2020-02-17T11:19:04Z"], "Metadata Updated": ["2023-06-28T12:51:33Z"], "Contact Name": ["Ketil Isaksen"], "Contact Email": ["ketil.isaksen@met.no"], "Organization": ["Norwegian Meteorological Institute"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "5652cfe1-6e6c-a412-719d-35aabae2e705", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 26.0, "Coordinates": "POINT (11.869267 78.925331)", "Networks": ["SIOS"], "Start Year": 2019, "Site Name": "NORCE vegetation monitoring site 3", "Web Links": ["https://sios-svalbard.org/node/1015"], "Site IDs": [1015], "Site Description": "Vegetation type on site: Dryas octopetala heath.\r\nPart of the project An automatic system for monitoring vegetation and environmental seasonal changes on Svalbard.", "Metadata Created": ["2020-12-29T12:22:40Z"], "Metadata Updated": ["2023-10-16T17:22:14Z"], "Contact Name": ["Bernt Johansen"], "Contact Email": ["bejo@norceresearch.no"], "Organization": ["NORCE"], "Related Locations": [], "Observed Properties": ["BIOSPHERE&gt;VEGETATION&gt;VEGETATION INDEX&gt;NORMALIZED DIFFERENCE VEGETATION INDEX (NDVI)", "AGRICULTURE&gt;SOILS&gt;SOIL MOISTURE/WATER CONTENT", "LAND SURFACE&gt;FROZEN GROUND&gt;SOIL TEMPERATURE", "SPECTRAL/ENGINEERING&gt;VISIBLE WAVELENGTHS&gt;VISIBLE IMAGERY", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "BIOSPHERE&gt;VEGETATION&gt;PHOTOSYNTHETICALLY ACTIVE RADIATION"], "Projects": [], "Project IDs": [11063.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "56b431b4-6a49-4bc9-13b5-34594db0ee19", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 26.0, "Coordinates": "POINT (14.50467 77.5611)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "SPICE: Autonomous snow depth station - CALYPSOBYEN", "Web Links": ["https://sios-svalbard.org/node/152390", "https://crios.pl/"], "Site IDs": [152390], "Site Description": "SPICE\r\nhttps://a2photonicsensors.com/spice-snow-depth-real-time/\r\nSpice - IoT telemetric sensor for snowpack depth measurement.\r\nThe Spice sensor is a sonar-based sensor used for measuring the depth of the snowpack and monitoring its evolution during the winter season. The instrument performs temperature compensation so as to increase the accuracy of the measurement.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nSecond contact person: Michał Laska (michal.laska@us.edu.pl)", "Metadata Created": ["2023-10-17T13:26:55Z"], "Metadata Updated": ["2023-10-17T14:25:26Z"], "Contact Name": ["Piotr Zagórski"], "Contact Email": ["piotr.zagorski@mail.umcs.pl"], "Organization": ["Maria Curie-Skłodowska University in Lublin"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;SNOW/ICE&gt;SNOW DEPTH", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
