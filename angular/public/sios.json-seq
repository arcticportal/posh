{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "1e5381f2-ca97-a5cb-b6a0-64ab423be4dd", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 11.0, "Coordinates": "POINT (15.53318 77.001877)", "Networks": ["SIOS"], "Start Year": 2007, "Site Name": "Hornsund Seismological Station HSP", "Web Links": ["https://sios-svalbard.org/node/656"], "Site IDs": [656], "Site Description": "Seismometer placed in the concrete fundament protected by the small wooden house is located in the vicinity of Polish Polar Station in Hornsund. \r\nSeismometer is powered using PSP resources. The data is transfered by cable to PSP and published online in open access catalogues, e.g.: https://ds.iris.edu/mda/PL/HSPB/", "Metadata Created": ["2020-02-17T14:21:58Z"], "Metadata Updated": ["2023-06-28T15:10:06Z"], "Contact Name": ["Kaj Michałowski"], "Contact Email": ["kaj@igf.edu.pl"], "Organization": ["Institute of Geophysics, Polish Academy of Sciences"], "Related Locations": ["Polish Polar Station"], "Observed Properties": ["SOLID EARTH&gt;TECTONICS&gt;EARTHQUAKES&gt;SEISMIC PROFILE&gt;SEISMIC BODY WAVES&gt;"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "1e81bced-c4f5-8426-6ea6-5167af4575ec", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 20.0, "Coordinates": "POINT (15.535867 77.003758)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "CR03 - InSAR Corner Reflector", "Web Links": ["https://sios-svalbard.org/node/152398", "https://crios.pl/"], "Site IDs": [152398], "Site Description": "InSAR corner reflectors for terrestrial laser scanning and aerial calibration. The reflectors are made of metal (structural steel, aluminium) and fully protected against corrosion by, e.g. galvanising or painting. The reflector consists of two reflecting elements made of three square planes (perforated and solid plates) arranged perpendicular to each other. The reflecting elements are made of 5 panels consisting of a frame made of closed profiles with a square cross-section with dimensions of 75 x 75 cm (external dimension). The installation is permanently attached to the ground.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2023-10-17T14:51:10Z"], "Metadata Updated": ["2023-10-17T14:56:49Z"], "Contact Name": ["Dariusz Ignatiuk"], "Contact Email": ["dariusz.ignatiuk@us.edu.pl"], "Organization": ["University of Silesia in Katowice, Faculty of Natural Sciences, Institute of Earth Sciences"], "Related Locations": [], "Observed Properties": ["SOLID EARTH&gt;GEODETICS&gt;COORDINATE REFERENCE SYSTEM"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
