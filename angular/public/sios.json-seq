{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "8f4580f6-1bb2-315e-36ec-b44ce0760bd1", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 460.0, "Coordinates": "POINT (15.3948 78.2288)", "Networks": ["SIOS"], "Start Year": 2001, "Site Name": "Radioclide at Plateau Berget​ (RN49)", "Web Links": ["https://sios-svalbard.org/node/152374", "https://dsa.no/"], "Site IDs": [152374], "Site Description": "The radionuclide station at Plateau Berget (RN49) is a part of the IMS International Monitoring System (IMS) which is designed to detect any nuclear explosion conducted on Earth, to verify compliance with the Treaty​", "Metadata Created": ["2023-09-11T09:28:46Z"], "Metadata Updated": ["2023-09-11T09:28:46Z"], "Contact Name": ["Morten Sickel"], "Contact Email": ["Morten@norsar.no"], "Organization": ["NORSAR"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC CHEMISTRY&gt;TRACE GASES/TRACE SPECIES"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
