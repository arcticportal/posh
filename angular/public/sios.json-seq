{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "d91b86de-0115-985d-0bc8-57b138d55b37", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 0.0, "Coordinates": "POINT (15.64395 78.22095)", "Networks": ["SIOS"], "Start Year": 2024, "Site Name": "CR04 - InSAR Corner Reflector", "Web Links": ["https://sios-svalbard.org/node/152399", "https://crios.pl/"], "Site IDs": [152399], "Site Description": "The reflector is stored in Longyearbyen and is waiting to be installed at the selected location.\r\n\r\nInSAR corner reflectors for terrestrial laser scanning and aerial calibration. The reflectors are made of metal (structural steel, aluminium) and fully protected against corrosion by, e.g. galvanising or painting. The reflector consists of two reflecting elements made of three square planes (perforated and solid plates) arranged perpendicular to each other. The reflecting elements are made of 5 panels consisting of a frame made of closed profiles with a square cross-section with dimensions of 75 x 75 cm (external dimension). \r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2023-10-17T14:54:46Z"], "Metadata Updated": ["2023-10-17T14:56:01Z"], "Contact Name": ["Dariusz Ignatiuk"], "Contact Email": ["dariusz.ignatiuk@us.edu.pl"], "Organization": ["University of Silesia in Katowice, Faculty of Natural Sciences, Institute of Earth Sciences"], "Related Locations": [], "Observed Properties": ["SOLID EARTH&gt;GEODETICS&gt;COORDINATE REFERENCE SYSTEM&gt;COUNTRY/REGIONAL COORDINATE REFERENCE SYSTEM"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Planned", "Site Type": ["not applicable"]}
