{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "3f178c4c-da93-4634-a972-37bcf091aa08", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 300.0, "Coordinates": "POINT (15.3641 77.0748)", "Networks": ["SIOS"], "Start Year": 1999, "Site Name": "Werenskioldbreen mass balance stake network", "Web Links": ["https://sios-svalbard.org/node/655", "http://ppdb.us.edu.pl/geonetwork/srv/eng/catalog.search#/metadata/5465a634-1c65-456e-b190-c11d75fa094d"], "Site IDs": [655], "Site Description": "The monitoring of the mass balance of the Werenskioldbreen (Wedel Jarlsberg Land, Spitsbergen, Svalbard) in the years 1999-2002 and 2009-2018. It is calculated on the base of 4 to 9 ablation stakes (depend on year). The mass balance is determined by conducting field surveys on floating calendar dates (floating-date system). Data have also been submitted to the World Glacier Monitoring Sevice (WGMS, https://wgms.ch)", "Metadata Created": ["2020-02-17T12:57:35Z"], "Metadata Updated": ["2023-06-29T14:36:26Z"], "Contact Name": ["Dariusz Ignatiuk"], "Contact Email": ["dariusz.ignatiuk@us.edu.pl"], "Organization": ["University of Silesia in Katowice, Faculty of Natural Sciences, Institute of Earth Sciences"], "Related Locations": ["Polish Polar Station"], "Observed Properties": ["CRYOSPHERE&gt;GLACIERS/ICE SHEETS&gt;GLACIER MASS BALANCE/ICE SHEET MASS BALANCE"], "Projects": [], "Project IDs": [3647.0, 3691.0, 4206.0, 6353.0, 10511.0, 10661.0], "Operating Status": "Operational", "Site Type": ["land platform (on ice)"]}
