{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "fa0225ce-6147-5e27-9681-f65ffed14425", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 4.0, "Coordinates": "POINT (14.50955 77.56147)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "Automatic Weather Station CRIOS-1 - CALYPSOBYEN", "Web Links": ["https://sios-svalbard.org/node/152405", "https://crios.pl/"], "Site IDs": [152405], "Site Description": "AWS is installed on the cabin approximately 400 meters NNW from Calypsobyen Station. The lens is aimed at us SE.\r\nThe height of sensors is approximately 2 m above land surface. \r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2023-10-18T11:51:51Z"], "Metadata Updated": ["2023-10-18T17:27:36Z"], "Contact Name": ["Piotr Zagórski"], "Contact Email": ["piotr.zagorski@mail.umcs.pl"], "Organization": ["Maria Curie-Skłodowska University in Lublin"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE", "ATMOSPHERE&gt;ATMOSPHERIC WATER VAPOR&gt;WATER VAPOR INDICATORS&gt;HUMIDITY&gt;RELATIVE HUMIDITY", "ATMOSPHERE&gt;ATMOSPHERIC WINDS&gt;SURFACE WINDS&gt;WIND SPEED", "ATMOSPHERE&gt;ATMOSPHERIC WINDS&gt;SURFACE WINDS&gt;WIND DIRECTION", "ATMOSPHERE&gt;ATMOSPHERIC RADIATION&gt;INCOMING SOLAR RADIATION"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "fb23ba49-250a-718c-591a-1211b249b8b0", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 5.0, "Coordinates": "POINT (16.456436 78.685726)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "STRING: thermistor string to measure ground temperature - Petuniabukta", "Web Links": ["https://sios-svalbard.org/node/152417", "https://crios.pl/"], "Site IDs": [152417], "Site Description": "The hole in the vicinity of the UAM station in Petuniabukta was delineated at a distance of about 50 m from the shoreline, in the zone between the Polish and Czech stations. The drilling was carried out on 22-23.07.2023. The bedrock is built up by siltstone and sandstone. At the drilling site, they are covered by thick-bedded beach sediments. During the drilling, a depth of 7 meters below sea level was reached, and with no further drilling progress, a decision was made to install a string to the depth obtained. \r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland \r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nAdditional contact persons: Grzegorz Rachlewicz (grzegorz.rachlewicz@amu.edu.pl), Dariusz Ignatiuk (dariusz.ignatiuk@us.edu.pl)\r\n\r\n* height above mean sea level to check", "Metadata Created": ["2023-10-19T16:54:57Z"], "Metadata Updated": ["2023-10-23T09:35:08Z"], "Contact Name": ["Krzysztof Senderak"], "Contact Email": ["krzysztof.senderak@uwr.edu.pl"], "Organization": ["University of Wrocław"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;FROZEN GROUND&gt;PERMAFROST&gt;PERMAFROST TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "fbcc1c52-7b44-6a58-0d45-199708316581", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 10.0, "Coordinates": "POINT (11.83393447 78.92080104)", "Networks": ["SIOS"], "Start Year": 2010, "Site Name": "Mast for Temperature Gradient", "Web Links": ["https://sios-svalbard.org/node/927"], "Site IDs": [927], "Site Description": "Bayelva", "Metadata Created": ["2020-09-07T13:19:36Z"], "Metadata Updated": ["2023-06-20T13:27:41Z"], "Contact Name": ["Julia Boike, Niko Bornemann"], "Contact Email": ["Julia.Boike@awi.de"], "Organization": ["Alfred Wegener Institute"], "Related Locations": [], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE"], "Projects": [], "Project IDs": [2950.0], "Operating Status": "Closed", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "fc184952-6ae0-d542-1301-879ae3906832", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 416.0, "Coordinates": "POINT (14.31578 77.49227)", "Networks": ["SIOS"], "Start Year": 2023, "Site Name": "SPICE: Autonomous snow depth and glacier ablation station - RENARDBREEN_2", "Web Links": ["https://sios-svalbard.org/node/152392", "https://crios.pl/"], "Site IDs": [152392], "Site Description": "https://a2photonicsensors.com/spice-snow-depth-real-time/\r\nSpice - IoT telemetric sensor for snowpack depth measurement.\r\nThe Spice sensor is a sonar-based sensor used for measuring the depth of the snowpack and monitoring its evolution during the winter season. The instrument performs temperature compensation so as to increase the accuracy of the measurement.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nSecond contact person: Michał Laska (michal.laska@us.edu.pl)", "Metadata Created": ["2023-10-17T13:58:32Z"], "Metadata Updated": ["2023-10-17T15:50:18Z"], "Contact Name": ["Piotr Zagórski"], "Contact Email": ["piotr.zagorski@mail.umcs.pl"], "Organization": ["Maria Curie-Skłodowska University in Lublin"], "Related Locations": [], "Observed Properties": ["CRYOSPHERE&gt;SNOW/ICE&gt;SNOW DEPTH", "LAND SURFACE&gt;GEOMORPHIC LANDFORMS/PROCESSES&gt;GLACIAL PROCESSES&gt;ABLATION", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (on ice)"]}
