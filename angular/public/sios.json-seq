{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "254ac6d1-cc21-c0d2-7635-142150f26c76", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 52.0, "Coordinates": "POINT (11.925192 78.923478)", "Networks": ["SIOS"], "Start Year": 2003, "Site Name": "GNSS Ionospheric scintillation and TEC monitor - Ny-Ålesund", "Web Links": ["https://sios-svalbard.org/node/152419", "http://eswua.ingv.it/index.php/gnss-scintillation/gnss-real-time-data", "https://doi.org/10.13127/eswua/gnss"], "Site IDs": [152419], "Site Description": null, "Metadata Created": ["2023-11-01T15:55:46Z"], "Metadata Updated": ["2023-11-01T16:38:26Z"], "Contact Name": ["Emanuele Pica"], "Contact Email": ["emanuele.pica@ingv.it"], "Organization": ["Istituto Nazionale di Geofisica e Vulcanologia (INGV)"], "Related Locations": ["Dirigibile Italia"], "Observed Properties": ["ATMOSPHERE&gt;ATMOSPHERIC ELECTRICITY&gt;TOTAL ELECTRON CONTENT"], "Projects": [], "Project IDs": [], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "25979004-da81-1ea2-6703-67222b18a3db", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": -198.0, "Coordinates": "POINT (12.01481667 78.94648333)", "Networks": ["SIOS"], "Start Year": 2015, "Site Name": "Mooring IndARC", "Web Links": ["https://sios-svalbard.org/node/965", "http://data.ncaor.gov.in/newhtml"], "Site IDs": [965], "Site Description": "Longitude: 12.01481667 E; Latitude: 78.94648333 N. \r\nDepth of the mooring from the surface: Sensors maintained below 24m from the surface from July 2014 till July 2019 and below 15m from the surface from July 2019 till date.\r\nCO2 data was collected at a nominal depth of 35 m below the surface through the IndARC-3 mooring in Kongsfjorden from July 2016 to July 2017 as a collaboration between NCPOR and Norwegian Polar Institute and Institute for Marine Research. The sensor has been deployed again at a nominal depth of 25 m in July 2019, which is underwater till date in IndARC-5. The contact person for this sensor is Agneta Fransson, NPI (Agneta.Fransson@npolar.no). \r\nAll the other data listed are collected by NCPOR, India", "Metadata Created": ["2020-11-02T14:27:33Z"], "Metadata Updated": ["2023-06-29T11:21:36Z"], "Contact Name": ["Divya David T"], "Contact Email": ["divya@ncpor.res.in"], "Organization": ["National Centre for Polar and Ocean Research (NCPOR)"], "Related Locations": [], "Observed Properties": ["OCEANS&gt;OCEAN CHEMISTRY&gt;CARBON DIOXIDE", "OCEANS&gt;OCEAN TEMPERATURE&gt;WATER TEMPERATURE", "OCEANS&gt;SALINITY/DENSITY&gt;SALINITY", "OCEANS&gt;OCEAN CIRCULATION&gt;OCEAN CURRENTS", "OCEANS&gt;OCEAN OPTICS&gt;PHOTOSYNTHETICALLY ACTIVE RADIATION", "OCEANS&gt;OCEAN OPTICS&gt;FLUORESCENCE", "OCEANS&gt;OCEAN OPTICS&gt;TURBIDITY", "OCEANS&gt;OCEAN CHEMISTRY&gt;NITRATE"], "Projects": [], "Project IDs": [10309.0, 10319.0], "Operating Status": "Operational", "Site Type": ["underwater platform (fixed)"]}
{"Source Catalog": "SIOS Observation Facility Catalogue", "Date Metadata Harvested": "2025-12-09T00:47:00+00:00", "POSDT ID": "27100110-98f5-4028-80f5-d045cf01c92e", "Images": [], "Funding Agency": [], "Metadata Creator": [], "Country": ["Norway"], "Elevation": 52.0, "Coordinates": "POINT (11.86548 78.92116)", "Networks": ["SIOS"], "Start Year": 2024, "Site Name": "SPICE: Autonomous snow depth station - Brøggerbreen tundra", "Web Links": ["https://sios-svalbard.org/node/153246", "https://crios.pl/"], "Site IDs": [153246], "Site Description": "SPICE\r\nhttps://a2photonicsensors.com/spice-snow-depth-real-time/\r\nSpice - IoT telemetric sensor for snowpack depth measurement.\r\nThe Spice sensor is a sonar-based sensor used for measuring the depth of the snowpack and monitoring its evolution during the winter season. The instrument performs temperature compensation so as to increase the accuracy of the measurement.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)", "Metadata Created": ["2024-10-11T12:04:13Z"], "Metadata Updated": ["2024-10-11T12:15:40Z"], "Contact Name": ["Jean-Charles Gallet"], "Contact Email": ["jean.charles.gallet@npolar.no"], "Organization": ["Norwegian Polar Institute"], "Related Locations": ["Sverdrup"], "Observed Properties": ["CRYOSPHERE&gt;SNOW/ICE&gt;SNOW DEPTH", "ATMOSPHERE&gt;ATMOSPHERIC TEMPERATURE&gt;SURFACE TEMPERATURE&gt;AIR TEMPERATURE"], "Projects": [], "Project IDs": [12089.0], "Operating Status": "Operational", "Site Type": ["land platform (fixed)"]}
