{"title":"Sozopol - Black Sea - Bulgaria","id":{"prefix":"https:\/\/deims.org\/","suffix":"04c70bae-b13c-4df5-bbdb-dc2be9e9d411"},"type":"site","created":"2012-12-25T19:04:29+01:00","changed":"2025-01-07T11:14:56+01:00","attributes":{"affiliation":{"networks":[{"network":{"name":"GERI","id":{"prefix":"https:\/\/deims.org\/networks\/","suffix":"c3abdc60-49f1-49db-81fe-863b7dbb21d3"}},"siteCode":null,"verified":true},{"network":{"name":"ILTER","id":{"prefix":"https:\/\/deims.org\/networks\/","suffix":"1aa7ccb2-a14b-43d6-90ac-5e0a6bc1d65b"}},"siteCode":null,"verified":true},{"network":{"name":"LTER Bulgaria","id":{"prefix":"https:\/\/deims.org\/networks\/","suffix":"20ad4fa2-cc07-4848-b9ed-8952c55f1a3f"}},"siteCode":"LTER_EU_BG_006","verified":true},{"network":{"name":"LTER Europe","id":{"prefix":"https:\/\/deims.org\/networks\/","suffix":"4742ffca-65ac-4aae-815f-83738500a1fc"}},"siteCode":null,"verified":true}],"projects":[{"label":"eLTER (H2020)","uri":"https:\/\/cordis.europa.eu\/project\/id\/654359"}]},"contact":{"siteManager":[{"type":"person","name":"Dimitar Berov","email":"dimitar.berov@gmail.com","orcid":null}],"operatingOrganisation":null,"metadataProvider":[{"type":"person","name":"Dimitar Berov","email":"dimitar.berov@gmail.com","orcid":null}],"fundingAgency":null,"siteUrl":[{"title":null,"value":"http:\/\/www.lter-bulgaria.net\/wordpress\/en\/sozopol\/"},{"title":"Site manager\u0027s profile page","value":"http:\/\/www.iber.bas.bg\/?q=en\/node\/111"}]},"general":{"abstract":"The Laboratory of Marine Ecology is one of the field stations of IBER-BAS, based in the town of Sozopol on the coast of the Black Sea. It is provided with upgraded equipment and modern laboratory facilities necessary for carrying out investigations on the biodiversity and functioning of the coastal marine ecosystems. The laboratory is equipped with facilities for general ecological studies, a chemical and instrumental laboratory, microscopes and stereomicroscopes and a workshop. Main scientific equipment: spectrophotometer and instruments for sediment and water sampling and analysis, a combined pH\/dissolved oxygen\/conductivity measuring Instrument (WTW), microscopes and equipment for phytoplankton and microbiological research. The laboratory uses SCUBA diving equipment and possesses a small research vessel suitable for work in the coastal zone. ","citation":null,"relatedIdentifiers":null,"status":{"label":"Operational","uri":"http:\/\/codes.wmo.int\/wmdr\/ReportingStatus\/operational"},"yearEstablished":1983,"yearClosed":null,"relatedSites":null,"siteName":"Sozopol - Black Sea","shortName":"Sozopol","siteType":"Stationary land-based site","protectionLevel":null,"landUse":null,"images":[{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/IMG_0086.JPG","alt":"Benthic ecology"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/IMG_1587%2520copy.jpg","alt":"Research vessel"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/03_iid4088.jpg","alt":"Pelagial studies"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/01.jpg","alt":"Microscope facilities"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/IMG_1555.jpg","alt":"General ecological laboratory"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/IMG_3739.JPG","alt":"Chemical laboratory"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/02.jpg","alt":"Laboratory vessel"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/sozopol-black-sea-bulgaria_6286.jpg","alt":"Benthic studies"},{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/sozopol-black-sea-bulgaria_6287.jpg","alt":"Bentic studies"}]},"environmentalCharacteristics":{"airTemperature":{"yearlyAverage":16,"monthlyAverage":null,"unit":"\u00b0C","referencePeriod":null},"precipitation":{"yearlyAverage":510,"monthlyAverage":null,"unit":"mm","referencePeriod":null},"biogeographicalRegion":"blacksea","biome":"marine","ecosystemType":[{"label":"Marine","uri":