{"title":"La Mancha Mex-LTER - Mexico","id":{"prefix":"https:\/\/deims.org\/","suffix":"e7c4f09b-8513-4b4b-a331-2fa718af3d60"},"type":"site","created":"2012-12-25T19:34:02+01:00","changed":"2021-03-11T11:07:32+01:00","attributes":{"affiliation":{"networks":[{"network":{"name":"Mex-LTER (Mexico)","id":{"prefix":"https:\/\/deims.org\/networks\/","suffix":"dae20892-ab85-4994-9c7c-797582f1d9f9"}},"siteCode":"LTER-NAM-MX-11","verified":true}],"projects":null},"contact":{"siteManager":[{"type":"person","name":"Jose Garcia-Franco","email":"jose.garcia.franco@inecol.mx","orcid":null}],"operatingOrganisation":null,"metadataProvider":null,"fundingAgency":null,"siteUrl":null},"general":{"abstract":"Ubicada al final de la cuenca del R\u00edo Actopan (ladera oriente del Cofre de Perote con fragmentos de bosque mes\u00f3filo de monta\u00f1a, agroecosistemas y poblados), La Mancha es el \u00faltimo refugio de selva mediana subcaducifolia  en la vertiente del Golfo. Contiene otros importantes ecosistemas costeros (manglar, dunas, selva baja, arrecifes, laguna costera), y es sitio de paso y descanso de aves migratorias. Presenta alta biodiversidad y una din\u00e1mica ecosist\u00e9mica compleja. Es la zona costera del Golfo de M\u00e9xico m\u00e1s estudiada en el pa\u00eds. Sitio RAMSAR desde 2005. Se localizan los \u00faltimos relictos de selva desarrollada sobre suelos arenosos y es ruta de aves migratorias rapaces mas importante a nivel mundial.","citation":null,"relatedIdentifiers":null,"status":{"label":"Operational","uri":"http:\/\/codes.wmo.int\/wmdr\/ReportingStatus\/operational"},"yearEstablished":1990,"yearClosed":null,"relatedSites":null,"siteName":"La Mancha Mex-LTER","shortName":"La Mancha","siteType":"Platform","protectionLevel":null,"landUse":null,"images":[{"url":"https:\/\/deims.org\/sites\/default\/files\/photos\/La%2520Mancha.jpg","alt":"not defined"}]},"environmentalCharacteristics":{"airTemperature":{"yearlyAverage":25,"monthlyAverage":null,"unit":"\u00b0C","refe