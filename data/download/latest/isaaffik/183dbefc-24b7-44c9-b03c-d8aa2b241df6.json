 "name": "GIOS Arctic Research Centre Mobile Observatory - Daneborg",
 "contactName": "Søren Rysgaard",
 "contactPhone": null,
 "contactEmail": "rysgaard@au.dk",
 "organizationLink": {
  "title": "",
  "url": "https://gios.org"
