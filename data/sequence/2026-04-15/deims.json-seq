 "Site Name": "LTSER Platform Koiliaris Critical Zone Observatory",
 "Web Links": [
  "https://deims.org/65d7bf15-841a-4fb7-a36e-6f4d95a8d64e",
  "http://www.koiliaris-czo.tuc.gr",
