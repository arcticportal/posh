{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "17cf8cb6-ade0-46b8-b3e6-032c9cb2e591",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "OZCAR-RI Draix-Bleone observatory Draix site",
 "Web Links": [
  "https://deims.org/17cf8cb6-ade0-46b8-b3e6-032c9cb2e591",
  "https://draixbleone.osug.fr/"
 ],
 "Site IDs": [
  "Draix",
  "https://deims.org/17cf8cb6-ade0-46b8-b3e6-032c9cb2e591"
 ],
 "Site Description": "Draix site is part of Draix-Bleone observatory, located in the French South Alps, upstream of Digne, on the left side of the Bleone. \r\n\r\nDraix site was equipped in 1983 to study mountain erosion and sediment transport. It is composed of 4 catchments, which are equipped to measure water and sediment fluxes, at spatial scales ranging from 0.001 km2 to 1 km2, with contrasted land cover. These catchments are entirely situated on black marls that are very sensitive to weathering and erosion, resulting into a badland topography. One catchment was reforested at the end of the XIXth century whereas the other are mostly denuded. This site is characterized by intense erosion and intermittent sediment fluxes. \r\n\r\nThe variables that are monitored on the long-term include rainfall and meteorology, high-frequency water discharge and suspended sediment concentration (1-10 minutes), event-scale bedload transport, and some physico-chemical properties of stream water and sediments.",
 "Images": [
  "https://deims.org/sites/default/files/2024-04/DSC00389.JPG",
  "https://deims.org/sites/default/files/2024-04/J%C3%A9r%C3%B4me%20Latron-011.JPG",
  "https://deims.org/sites/default/files/2024-04/DRAIX_PANORAM_DR.JPG"
 ],
 "Metadata Created": "2024-04-19T15:42:02+02:00",
 "Metadata Updated": "2024-05-21T14:33:46+02:00",
