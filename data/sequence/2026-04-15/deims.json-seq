{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "fe549052-0fca-45dc-9fc3-77dfb6a05ee0",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Mountain catchment",
 "Web Links": [
  "https://deims.org/fe549052-0fca-45dc-9fc3-77dfb6a05ee0",
  "http://www.lter.cz/index.php?option=com_content&view=category&layout=blog&id=28&Itemid=33&lang=en"
 ],
 "Site IDs": [
  "Mountain catchment",
  "https://deims.org/fe549052-0fca-45dc-9fc3-77dfb6a05ee0"
 ],
 "Site Description": "The catchment of the Modrý Potok stream belongs to the network of 14 small catchments (GEOMON), where effects of the changing environment (acidification, eutrophication, global change) on catchment biogeochemistry are studied. The catchment represents unique alpine ecosystem (alpine meadows with limited forest cover).\r\nSimilarly to the rest of the Czech Republic, a marked decrease in acid deposition has been observed since the 1980s. The measured precipitation chemistry revealed the decrease in sulphur deposition by 80% and moderate decrease in nitrogen deposition (by 50%) since 1994. The decline in acid deposition was caused by reductions of SO2, NOx, and NH3 emissions from heavy industry and thermal power plants (desulphurization). Mountain ecosystem responses to these changes in precipitation acidity were immediate – among other parameters, stream water pH as well as acid neutralizing capacity have increased since 1994. Concurrently, nitrogen retention within the catchment has increased (see the plot below) suggesting that recovery of soil environment has started. These profound changes might have further positive impacts on terrestrial biodiversity.",
 "Images": [
  "https://deims.org/sites/default/files/photos/mountain-catchment-czech-republic_4584.jpg"
 ],
 "Metadata Created": "2012-12-25T19:07:36+01:00",
 "Metadata Updated": "2021-11-23T11:49:15+01:00",
 "Contact Name": [
  "Miroslav Tesar"
 ],
 "Contact Email": [
  "miroslav.tesar@iol.cz"
 ],
 "Organization": [
  "Forests of the Czech Republic, state enterprise",
  "Institute of Hydrodynamics, Czech Academy of Sciences",
  "Krkonose National Park Administration"
 ],
 "Funding Agency": [
