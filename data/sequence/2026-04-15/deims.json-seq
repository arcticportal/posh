 "Site Name": "LTSER Platform Austrian Central Alps (ACA)",
 "Web Links": [
  "https://deims.org/8cf20f01-7aa1-418b-a613-a95ceeb350dd",
  "http://www.lter-austria.at/ta-tyrolean-alps/"
