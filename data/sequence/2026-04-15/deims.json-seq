{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "88eb341d-e055-4a4f-a23a-6ba7d883cbc4",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Endalen",
 "Web Links": [
  "https://deims.org/88eb341d-e055-4a4f-a23a-6ba7d883cbc4"
 ],
 "Site IDs": [
  "https://deims.org/88eb341d-e055-4a4f-a23a-6ba7d883cbc4"
 ],
 "Site Description": "In this project we monitor temporal trends in bird communities in a high-altitude birch-dominated habitat in Central Norway. The project aims to monitor both community composition and changes in territory size among and within species in the study period. The study started in 1967 and is still on-going.\r\n\r\nMethods: Standardized transects are monitored 10 timed in early parts of the breeding season, following a GPS-track of 3km. Bird species and numbers are noted and placed relative in the habitat. This is done to potentially estimate territory size, which is performed by standardized formulas annually. Both seen and heard individuals are noted.",
 "Images": [
  "https://deims.org/sites/default/files/2023-01/Endalen.jpg",
  "https://deims.org/sites/default/files/2023-01/PHR.jpg"
 ],
 "Metadata Created": "2014-11-28T00:00:00+01:00",
 "Metadata Updated": "2023-07-24T14:04:58+02:00",
 "Contact Name": [
  "Jørgen  Søraker"
 ],
 "Contact Email": [
  "jorgen.s.soraker@ntnu.no"
 ],
 "Metadata Creator": [
  "Per Gustav Thingstad"
 ],
 "Country": [
  "Norway"
 ],
 "Coordinates": "POINT (10.5 62.75)",
 "Observed Properties": [
  "biological parameter"
 ],
