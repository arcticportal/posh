{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "5a57bb0e-69b0-42d0-8776-8d49e9d134ca",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Hölstein",
 "Web Links": [
  "https://deims.org/5a57bb0e-69b0-42d0-8776-8d49e9d134ca",
  "https://www.unibas.ch/de/Aktuell/News/Uni-Research/Waldexperiment-untersucht-Auswirkungen-des-Klimawandels.html"
 ],
 "Site IDs": [
  "SCC II",
  "https://deims.org/5a57bb0e-69b0-42d0-8776-8d49e9d134ca"
 ],
 "Site Description": "The Hölstein site is located in in the eastern part of the Swiss Jura mountains (47°26’16.4’’, 7°46’31.1’’; 540 m a.s.l.), in a mixed, temperate forest with an exceptionally high biodiversity and a vigorous tree regeneration. The research plot has a size of 1.6 ha and comprises 540 mature trees. The main tree species are Fagus sylvatica and Picea abies with an admixture of Abies alba, Quercus petraea, Pinus sylvestris, Acer pseudoplatanus, Carpinus betulus, Fraxinus excelsior and Sorbus torminalis. A canopy crane is installed in the center of the research area to access the tree canopies for in situ measurements and for sampling of leaf material. Rainout shelters will be installed in 2019 for conducting a long-term throughfall exclusion experiment.",
 "Images": [
  "https://deims.org/sites/default/files/photos/swiss-canopy-crane-ii-switzerland_6103.jpg"
 ],
 "Metadata Created": "2017-07-10T13:19:15+02:00",
 "Metadata Updated": "2025-01-07T11:14:56+01:00",
