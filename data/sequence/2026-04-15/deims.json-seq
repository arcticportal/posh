 "Site Name": "Monumento Naturale Torre Flavia (Roma)",
 "Web Links": [
  "https://deims.org/e618c7ca-2b92-46cb-9156-d87336c5a81f",
  "https://b2share.eudat.eu/records/da417c6d29744e90945f962efec3d01f",
  "https://b2share.eudat.eu/records/12a066f57cc246d2b3ddd288a03781ad"
 ],
 "Site IDs": [
  "IT20-001-T",
  "https://deims.org/e618c7ca-2b92-46cb-9156-d87336c5a81f"
 ],
 "Site Description": "The site, located along the Tyrrhenian coast, north of Rome city, is a Special Protection Area (SPA) for migratory and nesting birds (Anatidae, Ardeidae). The wetland area is one of the last stretches of the Lazio wetlands which have been progressively reclaimed and cultivated during the last century. The flora and the fauna of the site is not only highly specialized but also highly endangered, with a relevant ecological value evidenced in previous studies. The site includes coastal dune habitats of European interest, as the annual vegetation of drift lines, the embryonic shifting dunes, the mobile dunes with Ammophila arenaria and the dune grasslands. There are also habitats related to wet and mud soils, as Mediterranean salt meadows and reed beds dominated by Phragmites australis.",
 "Images": [
  "https://deims.org/sites/default/files/photos/Torre%2520Flavia%2520%25283%2529.JPG",
  "https://deims.org/sites/default/files/photos/monumento-naturale-torre-flavia-roma-italy_6222.jpg"
 ],
