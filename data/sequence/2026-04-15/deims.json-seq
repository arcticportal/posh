{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "d9c656cd-90a9-4d3f-9912-16aed2b77088",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Biodiversity of Santa Catarina: studing the association between landscape and biological diversity in two protected areas of Santa Catarina State",
 "Web Links": [
  "https://deims.org/d9c656cd-90a9-4d3f-9912-16aed2b77088"
 ],
 "Site IDs": [
  "BISC",
  "https://deims.org/d9c656cd-90a9-4d3f-9912-16aed2b77088"
 ],
 "Site Description": "Os estudos estão sendo realizados no Parque Nacional de São Joaquim (PNSJ) e um no Parque Estadual do Acaraí (PAEAC). Essas duas UCs representam alguns dos ecossistemas da região sul do Brasil protegidos por lei, mas carentes de estudos de longo prazo que associem paisagem e biodiversidade. Em conjunto elas representam um gradiente ecológico que abrange desde ecossistemas costeiros, situados ao nível do mar, até as matas nebulares, localizadas em altitudes superiores a 1400m. Os dois módulos instalados no PNSJ, estão em áreas com relevo irregular que variam de 1000 a 1800m de altitude, onde os remanescentes de Matas de Araucárias, Campos de Altitude e Matas Nebulares dominam a paisagem. Por outro lado, o módulo do PAEAC destaca-e por ser o único módulo inteiramente inserido na região de Restingas e Florestas de Terras Baixas, representando o mais importante remanescente contínuo de ecossistemas costeiros em Santa Catarina. Condições estas que os torna susceptíveis as alterações climáticas e, portanto áreas prioritárias para o desenvolvimento de estudos ecológicos em longo prazo.",
 "Images": [
  "https://deims.org/sites/default/files/photos/biodiversity-santa-catarina-studing-association-between-landscape-and-biological-diversity-two.jpg"
 ],
 "Metadata Created": "2018-12-18T15:31:47+01:00",
 "Metadata Updated": "2020-06-29T11:52:00+02:00",
