 "Site IDs": [
  "GMS",
  "https://deims.org/b7ce5577-9298-4878-aaf8-3f9abcd90286"
 ],
 "Site Description": "The GMS (34°45′N, 127°59′E) is located in the southern coast of Gyeongsangnam-do, and belongs to warm-temperate forest zone. The long-term (1981–2010) annual mean temperature and precipitation were 14.1 °C and 1839.4 mm, respectively (Korea Meteorological Administration 2015). The dominant species are Q. serrata, Chamaecyparis obtusa, A. pseudosieboldianum, Carpinus tschonoskii, and Stewartia pseudocamellia. This area is originally a natural forest; however, it is adjacent to the C. obtusa plantation created in the past. Furthermore, it is possible to observe the expansion of C. obtusa through the natural regeneration of young trees.",
 "Metadata Created": "2012-12-25T19:33:27+01:00",
 "Metadata Updated": "2021-03-03T11:50:49+01:00",
 "Organization": [
  "National Institute of Forestry Science"
 ],
