{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "7da245b4-d88c-41c9-91d1-f071602f0d95",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "AusLTER - Upland Heath Swamps Plot Network - Dharawal National Park, Sydney Basin, NSW, Australia",
 "Web Links": [
  "https://deims.org/7da245b4-d88c-41c9-91d1-f071602f0d95",
  "http://dx.doi.org/10.25911/5c1313b2b2644"
 ],
 "Site IDs": [
  "Dharawal National Park",
  "https://deims.org/7da245b4-d88c-41c9-91d1-f071602f0d95"
 ],
 "Site Description": "The Upland Heath Swamps Plot Network is located in the Dharawal National Park, near Sydney, NSW. \r\n\r\nSampling of vegetation is stratified along the soil moisture gradient and across the range of structural variability in the vegetation. Thus, three categories of soil moisture and three categories of vegetation structure (based on the height and form of shrubs) are sampled in a factorial design at 60 sites in upland swamps scattered throughout the study area (Keith & Myerscough 1993).\r\n\r\nTemporal visits are conducted every 5 years or when fires occur.\r\n\r\nBetween 2012 and 2018 the Upland Heath Swamps Plot Network was a member of Long Term Ecological Research Network (LTERN), Australia, a facility of the Australian Government's Terrestrial Ecosystem Research Network (TERN).",
 "Metadata Created": "2016-06-15T09:08:51+02:00",
 "Metadata Updated": "2023-08-08T09:15:51+02:00",
 "Contact Name": [
  "David Keith"
 ],
