 "Site IDs": [
  "GBS",
  "https://deims.org/7d77799b-e36a-4dd6-b97c-78aba5ad9de8"
 ],
 "Site Description": "Mt. Gyebangsan Forest (37° 44\" 19' N, 128° 27\" 11' E) is located in the border between Hongcheon and Pyeongchang in Gangwon-do, and belongs to a typical temperate northern cool temperature forest with lower average annual temperatures than the other regions. The long-term (1981-2010) annual mean temperature and precipitation were 10.3 °C and 1405.4 mm. The main dominant species were Quercus mongolica, Acer pseudosieboldianum, Tilia amurensis, Betula schmidtii, Pinus densiflora, and Kalopanax septemlobus.",
 "Metadata Created": "2012-12-25T19:33:23+01:00",
 "Metadata Updated": "2021-03-03T11:49:44+01:00",
 "Organization": [
  "National Institute of Forestry Science"
 ],
