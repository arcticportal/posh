 ],
 "Site IDs": [
  "Monteschino",
  "https://deims.org/51d0598a-e9e1-4252-8850-60fc8f329aab"
 ],
 "Site Description": "The grassland site is located in the area of Muntatschinig (Monteschino) and comprises meadows and dry pastures at an elevation of app. 1500m a.s.l.. The site was first established in 2008 as a weather station and was expanded in the following years. In 2010 the University of Innsbruck installed an eddy covariance station. Nine automatic lysimeters were added to measure evapotranspiration and water use efficiency. Since 2012 a rain-out shelter system has been used for simulating spring and summer droughts. This site is one of the sites along the elevation transect used for grassland studies.",
 "Images": [
  "https://deims.org/sites/default/files/photos/monteschino.jpg"
 ],
 "Metadata Created": "2015-09-30T14:12:27+02:00",
