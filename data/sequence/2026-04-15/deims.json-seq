 "Site Name": "Schorfheide-Chorin",
 "Web Links": [
  "https://deims.org/94c53dd1-acad-4ad8-a73b-62669ec7af2a",
  "http://www.schorfheide-chorin.de/texte/seite.php?id=109471&lang=en",
