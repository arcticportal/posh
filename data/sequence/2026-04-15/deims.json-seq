 "Site Name": "AusLTER - Woodland Restoration Plot Network",
 "Web Links": [
  "https://deims.org/28ea7cd3-b4d6-4537-9fb7-ab67d86a39f6",
  "http://dx.doi.org/10.25911/5c36e5688ff89"
 ],
 "Site IDs": [
  "Woodland Restoration",
  "https://deims.org/28ea7cd3-b4d6-4537-9fb7-ab67d86a39f6"
 ],
 "Site Description": "The Woodland Restoration Plot Network is located in the Cumberland Plain, Western Sydney, NSW, Australia with the objective to develop robust methods for evaluating the success of native woodland restoration on retired agricultural land and apply them to a major restoration project of an endangered ecological community. The plot network aims to determine whether the composition and structure of restoration plantings undertaken between 1992 and 2002 are on a trajectory from abandoned exotic pasture towards comparatively undisturbed remnant vegetation. The data gathered will inform future restoration efforts.\r\n\r\nBetween 2012 and 2018 the Woodland Restoration Plot Network was is a member of Long Term Ecological Research Network (LTERN), Australia, a facility of the Australian Government's Terrestrial Ecosystem Research Network (TERN).",
 "Images": [
  "https://deims.org/sites/default/files/photos/D%2520Keith%2520Woodland%2520Restoration%2520image.JPG"
 ],
 "Metadata Created": "2016-06-19T08:04:17+02:00",
 "Metadata Updated": "2022-07-13T06:02:38+02:00",
