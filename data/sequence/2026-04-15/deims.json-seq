{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "934255b2-82d5-4f52-81c2-9297208d3fbf",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Fundata-beech",
 "Web Links": [
  "https://deims.org/934255b2-82d5-4f52-81c2-9297208d3fbf",
  "http://www.icas.ro"
 ],
 "Site IDs": [
  "SSI Fundata-fag",
  "https://deims.org/934255b2-82d5-4f52-81c2-9297208d3fbf"
 ],
 "Site Description": "Installed in 1991, Fundata-beech represents an ICP-Forests level II plot, being selected as core plot in Futmon Project. Main parameters investigated in this plot are: crown condition, air chemistry, biodiversity, terrestrial biomass, soil properties, total nitrogen input, phenology, meteorology. The main research topics are: pollution effects, ecosystem structure, biodiversity driven by land use, biodiversity driven by climate change, forest ecology",
 "Images": [
  "https://deims.org/sites/default/files/photos/fundata-beech-romania_4899.jpg",
  "https://deims.org/sites/default/files/photos/fundata-beech-romania_4900.jpg",
  "https://deims.org/sites/default/files/photos/fundata-beech-romania_4901.png"
 ],
