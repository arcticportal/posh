 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Arctic-alpine tundra",
 "Web Links": [
  "https://deims.org/48660128-e478-42a4-91f8-b83a8735ba50",
