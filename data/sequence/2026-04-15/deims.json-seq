 "Site IDs": [
  "https://deims.org/4089113c-7878-4777-b365-547865df38a8"
 ],
 "Site Description": "The station Nivolet (ICOS code IT-Niv) is an unmanaged subalpine grassland located in the Gran Paradiso National Park (GPNP, north-western Italy), a highly-protected, closed hydrological basin part of the European LTER network. The site is covered with Alpine pasture, with typical high-altitude species among the dominant species. The vegetation undergoes a fast phenological change during the summer months from mid-late June to October. At 2750 meters above sea level it is covered by snow about 200 days per year.",
 "Metadata Created": "2024-08-28T15:23:19+02:00",
 "Metadata Updated": "2024-10-10T15:16:18+02:00",
