 ],
 "Site IDs": [
  "Eng_mar",
  "https://deims.org/3706b1ea-2aad-4363-bf4d-ba3ccba584e6"
 ],
 "Site Description": "Western part of the Gulf of Riga (the Baltic Sea) littoral  and sublitoral zone. The marine site is located on the west coast of the Gulf, in the Engure Nature protected area. The monitoring activities are based on three transects which represent an open area of very similar substrate type. These transects are located on the tip of Mersrags, 2.5 km northwards from the port of Mersrags. Long-term studies of the Gulf of Riga coastal zone communities and macrophytes as the key component of littoral zone under natural and anthropogenic impact and possible threats to the littoral zone biological resources. The   SCUBA diving is used in marine site  assessment.",
 "Images": [
  "https://deims.org/sites/default/files/photos/engure-marine-site-latvia_5514.jpg"
 ],
