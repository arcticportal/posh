{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "d430b474-ce2b-4ccc-a5f5-00f56e5a905c",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Laqueuille",
 "Web Links": [
  "https://deims.org/d430b474-ce2b-4ccc-a5f5-00f56e5a905c"
 ],
 "Site IDs": [
  "https://deims.org/d430b474-ce2b-4ccc-a5f5-00f56e5a905c"
 ],
 "Site Description": "The French Laqueuille site (ICOS code FR-Lqu) is part of the long-term national research platform on biodiversity and biogeochemical cycles (SOERE-ACBB) and is located on permanent semi-natural upland grassland in the Massif Centrale, France. Historically, the area was converted (from crop) into grassland more than sixty years ago, so the station is surrounded by mown and grazed grasslands. The climate is semi-continental and the soil is an Andosol (16% clay, 56% silt, 28% sand) with 11% carbon and 18% organic matter in the top 10 cm, resulting a mean soil organic soil C stock of 23 kgC m-2 in 0-60cm layer.",
 "Metadata Created": "2024-09-11T08:54:40+02:00",
 "Metadata Updated": "2025-02-20T11:20:09+01:00",
 "Country": [
  "France"
 ],
 "Coordinates": "POINT (2.7349 45.6444)",
 "Networks": [
  "GERI",
  "ICOS"
 ],
 "Operating Status": "Operational"
}
