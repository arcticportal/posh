{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "aed26423-9280-408f-b8d7-73d6495e232b",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Domaine de Belval-Bois-des-Dames",
 "Web Links": [
  "https://deims.org/aed26423-9280-408f-b8d7-73d6495e232b",
  "https://domaine-belval.org/",
  "https://www.zarg.fr/"
 ],
 "Site IDs": [
  "Domaine de Belval",
  "https://deims.org/aed26423-9280-408f-b8d7-73d6495e232b"
 ],
 "Site Description": "The Belval-Bois-des-Dames hunting estate, located in the northern part of the Argonne forest, is one of five identified workshop sites of LTSER Zone Atelier environnementale rurale Argonne – France. It is managed by the François Sommer Foundation for Hunting and Nature (FFS). The foundation has defined three main missions for this estate: training in sustainable hunting methods and large mammals management, preservation of natural environment, and scientific research and long-term biodiversity monitoring.\r\n\r\nThe estate is a 1,000-hectare forest park, entirely enclosed by a fence that is impervious to large mammals (deer, roe deer, and wild boar) but transparent to other species, particularly birds and carnivores. It is primarily covered by deciduous forest stands managed by the public French National Forestry Office, and also includes a 50-hectare complex of wetlands and ponds, as well as clearings. To support research programs within the park, the FFS has funded the construction of a building complex, scheduled for completion in 2026. This complex includes a laboratory, classrooms, conference and meeting rooms, and accommodation for trainees and research teams. The ultimate goal of the FFS and ZARG is to open all infrastructure and equipment to research teams who wish to do so, with the option of adapting the facilities to their own needs.",
 "Images": [
  "https://deims.org/sites/default/files/2025-07/Belval-Bois-des-Dames_FB.jpg",
  "https://deims.org/sites/default/files/2025-07/470239474_1860986154308913_2220658360398052449_n.jpg",
  "https://deims.org/sites/default/files/2025-07/512593423_1019157647096298_726954950283026578_n.jpg"
 ],
 "Metadata Created": "2025-07-24T10:09:28+02:00",
