 "Site IDs": [
  "ZARG",
  "https://deims.org/356224c0-4443-4498-9604-2d8b3d71641f"
 ],
 "Site Description": "The LTSER Zone Atelier environnementale rurale Argonne (ZARG) belongs to LTER-France network and is located in north-eastern France. The ZARG project was created in 2021, but fully labelled in 2023. ZARG focuses on socio-environmental topics, such as environmental protection, sustainable development and natural resource management, in the social context of high rurality, with a mean density of population around 16 inhabitants per km². The structure involve researchers from French national research centers or instituts (CNRS, INRAE), six French universities, and a local territorial association. Research programs carried out by ZARG members relie on a strong implication of local authorities and socio-economical actors.",
 "Images": [
  "https://deims.org/sites/default/files/2025-01/M%C3%A9thaniseur_0.jpg",
  "https://deims.org/sites/default/files/2025-01/A34_24_chevreuilSprint_0.JPG",
  "https://deims.org/sites/default/files/2025-01/20240729_112631_0.jpg"
 ],
