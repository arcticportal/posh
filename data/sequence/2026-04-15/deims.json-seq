{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "3dd2c069-d086-45d4-ab74-f9f43f2810cd",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Mooseurach",
 "Web Links": [
  "https://deims.org/3dd2c069-d086-45d4-ab74-f9f43f2810cd"
 ],
 "Site IDs": [
  "https://deims.org/3dd2c069-d086-45d4-ab74-f9f43f2810cd"
 ],
 "Site Description": "The station Mooseurach (ICOS code DE-Msr) is a forested bog located about 37 km South of Munich, in the region of Bavaria, Germany. The site is part of a large bog complex (250 ha) that was drained at the beginning of the 20th century, and the research area was afforested in 1967. The site is currently dominated by downy birch (Betula pubescens Ehrh.), alder buckthorn (Frangula alnus Mill.), and Norway spruce (Picea abies L. Karst). The site is situated in a region where the climate transitions from oceanic to continental. Locally, the climate is influenced by the Starnberg Lake, which is located about 10 kilometers west of Mooserauch: air masses that move across the lake become more humid.",
 "Metadata Created": "2024-08-28T15:27:46+02:00",
 "Metadata Updated": "2024-11-04T10:16:46+01:00",
