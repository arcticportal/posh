{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "7e840801-4a73-4c93-9f11-62e8db5f0329",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Fukang Desert Ecological Research Station",
 "Web Links": [
  "https://deims.org/7e840801-4a73-4c93-9f11-62e8db5f0329"
 ],
 "Site IDs": [
  "Fukang Station",
  "https://deims.org/7e840801-4a73-4c93-9f11-62e8db5f0329"
 ],
 "Site Description": "Fukang Station in the hinterland of the Eurasian continent (44o17'N, 87o56'E and 475 m a.s.l.). The station is 8 km from the southern edge of the Gurbantonggut Desert and 72 km south of the highest peak of the eastern Tianshan Mountains (5445 m a.s.l.). The study area is fairly flat (slope < 1o), and the groundwater table fluctuates between 2-5m depth. The soil is a silty clay-loam, consisting of 7% clay, 32% sand and 61% silt, with total nitrogen and C contents of 0.068 and 1.064%, respectively. The local climate is temperate continental arid with hot summers and cold winters. The winter extends from November to late March; and includes a snow cover of 20-30 cm. The growing season usually starts in early May and ends in late October. Mean annual air temperature is 6.6°C. Mean annual precipitation is 163 mm, with the majority of it (60-70%) falling between May and September.",
 "Images": [
  "https://deims.org/sites/default/files/photos/iid_2162.jpg",
  "https://deims.org/sites/default/files/photos/iid_2163.jpg"
 ],
