{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "2e6014fe-8f3b-4127-8ab1-405ae1303281",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Cres - Lošinj",
 "Web Links": [
  "https://deims.org/2e6014fe-8f3b-4127-8ab1-405ae1303281",
  "https://eunis.eea.europa.eu/sites/HR3000161"
 ],
 "Site IDs": [
  "HR3000161",
  "https://deims.org/2e6014fe-8f3b-4127-8ab1-405ae1303281"
 ],
 "Site Description": "Large marine site located in the Kvarnerić area, around the sheltered coast and waters of the eastern part of the Lošinj and Cres archipelago. It is one of the most important feeding and breeding areas for bottlenose dolphins (Tursiops truncatus) in the Eastern Adriatic.\r\nLithostratigraphic units represented on the coast are dolomites and post sedimentary diagenetic breccia (upper albian, lower cenomanian - K16, K12), rudist limestones (cenomanianmaastricht - K21-6). Soils on the coast are rockyground, anthropogenic soil on karst. The area was created after the transgression of the sea after the last glaciation; marine shelf; highly indented coastline.\r\nIn July 2006 of preventive protection of a part of the Kvarnerić region for 3 years as a Special Marine Reserve (Cres-Lošinj Special Marine Reserve – CLSMR has been declared.",
 "Images": [
  "https://deims.org/sites/default/files/2021-11/Cres_Losini.png"
 ],
 "Metadata Created": "2020-09-30T09:44:43+02:00",
 "Metadata Updated": "2021-11-04T11:52:44+01:00",
 "Organization": [
  "Blue World - Institute of Marine Research and Conservation"
 ],
