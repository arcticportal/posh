 "Site Name": "CNR Arctic Station “Dirigibile Italia”",
 "Web Links": [
  "https://deims.org/8832a901-c578-499e-80d0-48b62fb26f2f"
 ],
 "Site IDs": [
  "https://deims.org/8832a901-c578-499e-80d0-48b62fb26f2f"
 ],
 "Site Description": "CNR Arctic Station “Dirigibile Italia” is the Italian scientific station in Svalbard. It is funded and managed by the National Research Council of Italy (CNR). Research programmes currently developed at the station deals with microbial ecology and evolution; biogeochemistry and energy fluxes; vegetation and permafrost studies; oceanography, marine biomarkers; atmosphere, aerosols, gases and clouds; remote sensing of the environment; sun-earth relations and space weather; human biology and medicine.",
 "Metadata Created": "2024-10-07T15:04:38+02:00",
 "Metadata Updated": "2024-10-08T13:52:00+02:00",
 "Country": [
  "Svalbard and Jan Mayen"
 ],
