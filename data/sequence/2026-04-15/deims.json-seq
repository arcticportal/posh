 "Site IDs": [
  "VLIZ Buoy",
  "https://deims.org/177ff4a8-9481-495e-a55a-ec7d32bf6e30"
 ],
 "Site Description": "The site consists of a marine databuoy equipped with a suite of sensors that monitor water quality parameters and acoustic receivers for the detection of Porpoises and tagged fish. The buoy is moored near an offshore windmill farm, approx. 30km off the coast on the Belgian Continental Shelf.",
