 "Site Name": "Kampinoski National Park",
 "Web Links": [
  "https://deims.org/e738e254-0ee5-4b8f-bf98-f27a7dce1948",
  "http://www.lterpoland.pl/index.php?site=1&siteId=217&d=67",
