{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "9abe3e61-7bd8-461d-8674-c33e70f198ba",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "OZCAR-RI SNO_Karst : Karst Craie",
 "Web Links": [
  "https://deims.org/9abe3e61-7bd8-461d-8674-c33e70f198ba"
 ],
 "Site IDs": [
  "Karst Craie",
  "https://deims.org/9abe3e61-7bd8-461d-8674-c33e70f198ba"
 ],
 "Site Description": "The Chalk Karst observatory groups different karst sites on the Cretaceous Chalk located at the Paris Basin (Norville, Radicatel, Yport, Saint-Martin-Le-Nœud). These karst watersheds range from 10 to 200 km2 and the land use consists of agriculture and grazing under oceanic climate. There are characterized by chalk plateaus covered with clay-with-flints owing to chalk weathering constituting a fairly impervious layer and with quaternary silts. These surficial formations range from 3 to 20 meters depth and are highly susceptible to crusting, compaction, and erosion, particularly during autumn and winter. A numerous swallow holes locally penetrates the chalk through the above-mentioned impervious layer, resulting in a strong connection of the surface with the aquifer inducing infiltration of turbidity releases at spring and well used to drinking water (up to 500 NTU). \r\nThese Chalk karst sites are one the sites of the French SO-KARST labellised by INSU-CNRS and are a part of the French RBV-Network and ZA Seine.",
 "Images": [
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-karst-craie-france_6274.jpg",
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-karst-craie-france_6275.jpg",
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-karst-craie-france_6276.jpg"
 ],
