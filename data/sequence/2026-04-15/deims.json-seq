{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "80902e3b-16f6-4650-a2bd-515519b27277",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Forest-Atmosphere-Interaction-Research Site Obermieming",
 "Web Links": [
  "https://deims.org/80902e3b-16f6-4650-a2bd-515519b27277",
  "http://www.biomet.co.at/fair-site/"
 ],
 "Site IDs": [
  "FAIR Obermieming",
  "https://deims.org/80902e3b-16f6-4650-a2bd-515519b27277"
 ],
 "Site Description": "The Forest-Atmosphere-Interaction-Research (FAIR) site is an interfaculty, interdepartmental forest research platform of the University of Innsbruck situated in a Scots Pine forest some 30 km to the west of Innsbruck (Austria).\r\nThe research activities at the FAIR site currently revolve around five main interlinked research areas:\r\n- ecosystem carbon and water cycle\r\n- forest-atmosphere air quality interactions\r\n- boundary-layer meteorology in complex topography\r\n- remote and proximal sensing\r\n- model development, testing and validation",
 "Images": [
  "https://deims.org/sites/default/files/2024-12/Obermieming1.jpg"
