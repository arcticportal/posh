{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "6544abc3-1994-4ccd-9b85-95acbaf02712",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "OZCAR-RI SNO_KARST Jurassic Karst site",
 "Web Links": [
  "https://deims.org/6544abc3-1994-4ccd-9b85-95acbaf02712",
  "https://zaaj.univ-fcomte.fr/spip.php?article13&lang=en"
 ],
 "Site IDs": [
  "Jurassic_Karst",
  "https://deims.org/6544abc3-1994-4ccd-9b85-95acbaf02712"
 ],
 "Site Description": "The Jurassic Karst scheme in place since 2009 aims to characterise the long-term evolution of the karst aquifer system of the Jura mountains.\r\n\r\nThe specific topographical context of the Jura mountains allows the study of these aquifers at increasing altitudes along a climatic gradient. The plant cover and soil types vary along this gradient, thereby modulating the biogeochemical functioning of the infiltration zone of the karst hydrosystems.\r\n\r\nFour karst springs are monitored at sites of increasing altitude:\r\n\r\n    Fourbanne site (Doubs valley, near Baume-les-Dames): altitude 330 m, catchment surface 30 km2;\r\n    Lods site (upper Loue valley): altitude 380 m, approx. catchment surface 35 km2;\r\n    Fertans (Amancy plateau): altitude 530 m, approx. catchment surface 1 km2;\r\n    Mouthe (source of Doubs river): altitude 950 m, approx. catchment surface 50 km2.\r\n\r\nA number of physico-chemical parameters are monitored continuously on all sites, and supplemented weekly by automatic sampling at Fourbanne, Lods and Fertans.\r\n\r\nContact : Marc Steinmann;\r\nChrono-Environment Laboratory – University of Franche-Comté",
 "Images": [
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-jurassic-karst-site-france_6329.jpg",
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-jurassic-karst-site-france_6327.jpg",
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-jurassic-karst-site-france_6328.jpg",
  "https://deims.org/sites/default/files/photos/ozcar-ri-sno_karst-jurassic-karst-site-france_6330.jpg"
 ],
 "Metadata Created": "2013-12-10T07:04:31+01:00",
 "Metadata Updated": "2024-03-04T09:38:21+01:00",
