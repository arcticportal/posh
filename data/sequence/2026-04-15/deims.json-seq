{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "efe6fed0-2f58-4b0b-b0f9-e1b68d48032a",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Kainuu Fisheries Research Station",
 "Web Links": [
  "https://deims.org/efe6fed0-2f58-4b0b-b0f9-e1b68d48032a"
 ],
 "Site IDs": [
  "https://deims.org/efe6fed0-2f58-4b0b-b0f9-e1b68d48032a"
 ],
 "Site Description": "The history of the Kainuu Research Station started when the aquaculture activities was initiated in 1935. The main parts of the present station were built in 1994. Since 2002 the station was equipped to focus on experimental fish and aquatic ecology research. The station operates and is open for visitors throughout the year. The station has 14 beds, a laboratory, an auditorium, workshops, and internet access.\r\n\r\nThe station provides excellent opportunities to carry out ecological, environmental or management related research in laboratory and on a semi-natural scale. The research facilities include both indoor and outdoor set-ups of streams, indoor pools, outdoor pools, and combined stream-pool systems with video arrays and PIT-telemetry devices for observing and monitoring purposes. Water (max 750 l/s) for the streams and pools is taken from Lake Kivesjärvi (surface area 27 km2, mean water pH 6.7, oxygen 9.2 mg/l, total P 17.0 µg/l, and conductivity 3.5 mS/m).",
 "Metadata Created": "2024-10-11T15:25:43+02:00",
 "Metadata Updated": "2024-10-11T15:25:43+02:00",
 "Country": [
  "Finland"
 ],
 "Elevation": 135,
 "Coordinates": "POINT (27.51548333 64.40442222)",
 "Networks": [
  "INTERACT"
 ],
 "Operating Status": "Operational",
 "Start Year": 1935
}
