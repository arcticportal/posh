 ],
 "Site IDs": [
  "Three Parks",
  "https://deims.org/16f934fe-e77d-4769-8baf-c247a3ad3b71"
 ],
 "Site Description": "The Three Parks Savanna Fire-Effects Plot Network extends across three national parks (Kakadu, Litchfield and Nitmiluk) in the Top End of the Northern Territory. The fire monitoring program comprises two complementary components: satellite based mapping of fire events and on-ground assessment of change in biota at a set of permanent plots.\r\n\r\nTemporal visits are as follows:\r\n\r\n• 6 months (fire occurrence),\r\n• 4 months (fire mapping),\r\n• 5 years (vegetation), \r\n• opportunistic (fauna).\r\n\r\nBetween 2012 and 2018 the Three Parks Savanna Fire-Effects Plot Network was a member of Long Term Ecological Research Network (LTERN), Australia, a facility of the Australian Government's Terrestrial Ecosystem Research Network (TERN).",
 "Images": [
  "https://deims.org/sites/default/files/photos/Fire%2520in%2520NT%2520Savannas%252C%2520photo%2520from%2520Bushfire%2520CRC.jpg",
  "https://deims.org/sites/default/files/photos/IMG_1085.JPG"
 ],
