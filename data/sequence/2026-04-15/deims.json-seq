{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "41d4f6f2-a946-4c2d-8d30-53997d4eeb7c",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Auchencorth Moss",
 "Web Links": [
  "https://deims.org/41d4f6f2-a946-4c2d-8d30-53997d4eeb7c",
  "http://www.auchencorth.ceh.ac.uk/"
 ],
 "Site IDs": [
  "AMo",
  "https://deims.org/41d4f6f2-a946-4c2d-8d30-53997d4eeb7c"
 ],
 "Site Description": "The Auchencorth Moss (AMo) field, South East Scotland (55ᵒ47’36” N, 3°14’41” W), is an ombrotrophic peatland with an extensive fetch at an elevation of 270 m, lying 18 km SSW of Edinburgh, and can be categorised as a transitional lowland raised bog. The site is grazed with < 1 sheep ha-1.\r\n\r\nThe site was originally established in 1995 to measure concentrations of trace gases and aerosols. During 2000s the site activity has increased and was established in 2006 as EMEP (Level 2/3) supersite for the UK. Long term monitoring is led by NERC CEH with contributions from other organisations/research institutes including Ricardo AEA, BureauVeritas, NPL, the University of Birmingham and University of Edinburgh. In April 2014 the site was awarded WMO GAW regional station.\r\n\r\nCurrently CEH focus on three main areas of research at the AMo fieldsite: \r\n\r\n1. Surface-atmosphere exchange fluxes\r\n\r\n2. Atmospheric composition\r\n\r\n3. Carbon catchments",
 "Metadata Created": "2023-06-20T09:18:55+02:00",
 "Metadata Updated": "2025-02-19T13:36:52+01:00",
 "Organization": [
  "UK Centre for Ecology & Hydrology (UKCEH)"
 ],
 "Country": [
  "United Kingdom"
 ],
 "Elevation": 270,
 "Coordinates": "POINT (-3.244722 55.793333)",
 "Networks": [
  "European Monitoring and Evaluation Programme (EMEP)",
  "GERI",
  "ICOS",
  "WMO Global Atmosphere Watch (GAW)"
 ],
 "Projects": [
  "ICP Vegetation"
 ],
 "Operating Status": "Operational",
 "Start Year": 1995
}
