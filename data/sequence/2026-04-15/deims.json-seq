 "Site Name": "Värriö Research Station (Värriö LTER)",
 "Web Links": [
  "https://deims.org/b471311f-e819-4f6f-bbae-1ac86cd9777f",
  "https://www.helsinki.fi/en/research-stations/varrio-subarctic-research-station",
