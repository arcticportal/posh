{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "495881b0-52bc-410c-99b7-45575e08f80c",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Hailun Agricultural Ecological Station",
 "Web Links": [
  "https://deims.org/495881b0-52bc-410c-99b7-45575e08f80c"
 ],
 "Site IDs": [
  "Hailun Station",
  "https://deims.org/495881b0-52bc-410c-99b7-45575e08f80c"
 ],
 "Site Description": "Hailun Agricultural Ecological Station located in Hailun city, Heilongjiang province, was established in 1978, briefly named Hailun Agro-ecosystem Station. The main research fields at that time were the optimal management of agriculture and advanced technology utilization in agricultural production. Chinese ecosystem research network(CERN) established in 1988 selected Hailun station as one of its components. The objective of Hailun station was to study the agro-ecosystem and sustainable development of agriculture in black soil zone in Northease China. Also, Hailun station was considered as one of components, when national field research net was built in 2005.",
 "Images": [
  "https://deims.org/sites/default/files/photos/2102.jpg",
  "https://deims.org/sites/default/files/photos/2103.JPG",
  "https://deims.org/sites/default/files/photos/2104_.JPG"
