 "Site Name": "Silwood Park Ecotron",
 "Web Links": [
  "https://deims.org/63fcc185-d5c6-4452-869b-ef4407f68cf4"
 ],
 "Site IDs": [
  "https://deims.org/63fcc185-d5c6-4452-869b-ef4407f68cf4"
 ],
 "Site Description": "“The Ecotron” is a unique facility for controlled environment ecological experiments, designed to bridge the gap between the complexity of real field communities and the simplicity of laboratory or greenhouse studies. The facility has been extensively described in the scientific literature and includes 16 separate walk-in chambers with computer-controlled climatic conditions. Recent modifications of the facility allow it to emulate real weather data (temperature, humidity, light, rainfall and water table) for large mesocosms (up to 130 x 85 x 40cm).",
 "Metadata Created": "2013-02-03T15:27:40+01:00",
 "Metadata Updated": "2019-12-05T10:07:10+01:00",
 "Country": [
  "United Kingdom"
 ],
