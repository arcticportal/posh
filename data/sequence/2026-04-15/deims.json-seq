{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "911b287a-b96b-483c-96a6-619c288237cf",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "TERN Litchfield Savanna SuperSite",
 "Web Links": [
  "https://deims.org/911b287a-b96b-483c-96a6-619c288237cf",
  "https://www.tern.org.au/tern-observatory/tern-ecosystem-processes/litchfield-savanna-supersite/"
 ],
 "Site IDs": [
  "TERN LFLD SuperSite",
  "https://deims.org/911b287a-b96b-483c-96a6-619c288237cf"
 ],
 "Site Description": "The Litchfield Savanna SuperSite is a member of the Australian SuperSite Network (SuperSites, http://www.supersites.net.au/), a facility within the Australian Terrestrial Ecosystem Network (TERN, http://www.tern.org.au/). The Litchfield Savanna SuperSite represents high rainfall, frequently burnt, tropical savanna. At 1.9 million km2, tropical savanna is the dominant ecosystem type across northern Australia. Understanding biogeochemical cycles, impacts of fire on sequestration, vegetation and fauna is a national priority.\r\n\r\nThe site is a 5 km x 5 km block of relatively uniform open-forest savanna inside the park, and about 80 km south of Darwin. The infrastructure will help scientists understand the dynamics of vegetation structure and floristics by linking field observations with infrastructure measuring fluxes of carbon, water and energy. The fluxes will be linked to remotely sensed observations of vegetation cover and leaf area taken from the ground, aircraft and space.\r\n\r\nKey research objectives include: \r\n•\tWhat are the impacts of prevailing fire regimes (primarily frequency, but also intensity, extent, heterogeneity) on vegetation structure and composition, habitat quality, fragmentation and vertebrate faunal biodiversity?\r\n•\tHow does vegetation structure, climate drivers and fire regime influence savanna carbon sequestration rate?\r\n•\tHow can fire management contribute to greenhouse gas abatement and carbon sequestration in savanna ecosystems?\r\n•\tWhat are the impacts of climate change on fire regimes and subsequent feedbacks to savanna carbon and water cycles?\r\n\r\nLitchfield National Park encompasses the traditional boundaries of 4 Aboriginal language groups: Werat, Koongurrukun, Waray and Mak Mak Marranunggu",
 "Images": [
  "https://deims.org/sites/default/files/photos/tern-litchfield-savanna-supersite-australia_6447.jpg",
  "https://deims.org/sites/default/files/photos/tern-litchfield-savanna-supersite-australia_6448.jpg",
  "https://deims.org/sites/default/files/photos/tern-litchfield-savanna-supersite-australia_6449.jpg",
  "https://deims.org/sites/default/files/photos/tern-litchfield-savanna-supersite-australia_6450.png"
 ],
