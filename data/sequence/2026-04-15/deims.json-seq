{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:23+00:00",
 "POSDT ID": "14d4e775-b092-4b13-beb2-2962bf86b7a3",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "OZCAR-RI REAL COLLOBRIER Catchments",
 "Web Links": [
  "https://deims.org/14d4e775-b092-4b13-beb2-2962bf86b7a3",
  "https://bdoh.irstea.fr/REAL-COLLOBRIER/"
 ],
 "Site IDs": [
  "Real_Collobrier_catchment",
  "https://deims.org/14d4e775-b092-4b13-beb2-2962bf86b7a3"
 ],
 "Site Description": "The  Watershed  Research  and  Experimentation  of  Real  Collobrier  is  a  privileged  site  for  the \r\nobservation and the study of the water cycle in the Mediterranean forest. It is a landmark site of the \r\nhydro  regional  climatology  where  many  cognitive  approaches  have  been  carried  out.  Observation \r\nnetwork  allows  the  study  of  phenomena with a  particularly  fine  scale,  which  makes  it  an  ideal \r\nlaboratory  for  the  development  of  methodologies  directly  applicable  in  operation\r\nal  hydrology.  \r\nThe watershed is instrumented since 1966. It has long chronic hydro-climatic data for fifty years, with 15 rain gauges and 7 flow gauges. Climatology and physico-chemical measurements are also carried out continuously.\r\nThe multidisciplinary  approach, associated  with  specific  experiments,  allows  a  deepening  of  our understanding of the interaction soil-water-atmosphere.",
 "Images": [
  "https://deims.org/sites/default/files/photos/Rimbaud2.JPG"
 ],
 "Metadata Created": "2016-06-27T10:21:04+02:00",
 "Metadata Updated": "2024-03-04T09:35:37+01:00",
 "Contact Name": [
  "Patrick Arnaud"
 ],
 "Contact Email": [
  "patrick.arnaud@inrae.fr"
 ],
 "Organization": [
  "National Research Institute for Agriculture, Food and Environment (INRAE)"
 ],
