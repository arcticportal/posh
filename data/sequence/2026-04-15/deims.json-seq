{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-04-15T19:08:24+00:00",
 "POSDT ID": "d6d6ebc8-8151-46ac-8cd2-cbf0523461bf",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "RB Miller Station",
 "Web Links": [
  "https://deims.org/d6d6ebc8-8151-46ac-8cd2-cbf0523461bf"
 ],
 "Site IDs": [
  "https://deims.org/d6d6ebc8-8151-46ac-8cd2-cbf0523461bf"
 ],
 "Site Description": "Located at the east entrance of Kananaskis Country, R.B. Miller and Sheep River Stations are our research only facilities.\r\n\r\nR.B. Miller is located within the Park gates of Sheep River Provincial Park and has a newly constructed, off grid, 3-bedroom accommodation to sleep six researchers. The energy efficient building has electricity via solar panels, running water during the summer months, a composting toilet, and small office area. This station is extensively used for animal behaviour studies (Bighorn Sheep and Columbian ground squirrels) because of its isolated location and large nearby animal populations. Access to R.B. Miller opens from May 15 - December 1st and winter access requires additional permits. \r\n\r\nNew for 2019 is the Sheep River Site, outside of the Park gates, to provide year-round accommodation to researchers. The mobile home contains 3 bedrooms and sleeps 8 people with a kitchen facility and running water. \r\n\r\nAt both locations, researchers are responsible for their own meals and the general upkeep of the buildings. Limited wifi access is provided and both sites do not have cell phone coverage nor telephone. There is a public phone at the Sheep River Ranger Station approximately 10km from R.B. Miller and adjacent to the Sheep pad site.",
 "Metadata Created": "2024-10-09T15:55:12+02:00",
 "Metadata Updated": "2024-10-10T11:27:10+02:00",
 "Country": [
  "Canada"
 ],
 "Coordinates": "POINT (-114.6552249 50.6453387)",
 "Networks": [
  "INTERACT"
 ],
 "Operating Status": "Operational"
}
