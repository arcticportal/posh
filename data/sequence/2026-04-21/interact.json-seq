}
{
 "Source Catalog": "INTERACT",
 "Date Metadata Harvested": "2026-04-21T14:26:53+00:00",
 "POSDT ID": "96a84e4c-ff97-07a8-acba-5a5ef0a8bb82",
 "Source Catalog URL": "https://interact-gis.org/Home/Stations",
