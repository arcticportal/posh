 "Site Name": "Lammi Biological Station",
 "Web Links": [
  "https://www.helsinki.fi/en/research-stations/lammi-biological-station",
  "https://interact-gis.org/Home/Station/100"
 ],
 "Site IDs": [
  "LBS",
  100
 ],
 "Site Description": "<p>The Lammi Biological Station is located 130 km north of Helsinki, 35 km east of the city of Hämeenlinna and 40 km west of the city of Lahti in uplands between two major river basins, i.e. rivers Kokemäenjoki and Kymijoki. The Lammi LTER area consists of several core sites/areas from which the Evo Forest and Lake Area (EVO) is the largest one and has a special value in terms of long term ecological studies. Another important study area is Lake Pääjärvi and its surroundings.</p>",
 "Metadata Updated": "2023-10-18T08:53:40+00:00",
 "Contact Name": [
  "Janne Sundell"
 ],
 "Organization": [
  "University of Helsinki"
 ],
 "Country": [
  "Finland"
 ],
 "Related Locations": [
  "Lammi"
 ],
