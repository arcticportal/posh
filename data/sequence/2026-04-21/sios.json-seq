 "Source Catalog Logo URL": "https://sios-svalbard.org/system/files/common/Logo-SIOS-ORIGINAL-rgb-simple_trimmed_small.png",
 "Country": [
  "Norway"
 ],
 "Networks": [
  "SIOS"
 ],
 "Site Name": "STRING: thermistor string to measure ground temperature - Calypsobyen",
 "Web Links": [
  "https://sios-svalbard.org/node/152416",
  "https://crios.pl/"
 ],
 "Site IDs": [
  152416
 ],
 "Site Description": "On the coastal section selected for drilling at Calypsobyen, the bedrock contains siltstone and sandstone forming relict abrasion platforms, which are currently covered by loose sand and gravel beach sediments. The borehole was located near the mouth of the Scott River (right bank), at a distance of about 75 m from the shoreline and 900 m from the station. After stopping the drilling progress again at 5 m below sea level, a decision was made to install a string in the third hole.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland \r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)\r\n\r\nAdditional contact persons: Piotr Zagórski (piotr.zagorski@mail.umcs.pl), Dariusz Ignatiuk (dariusz.ignatiuk@us.edu.pl)",
 "Metadata Created": "2023-10-19T16:50:25+00:00",
 "Metadata Updated": "2023-10-23T09:44:02+00:00",
 "Contact Name": [
  "Krzysztof Senderak"
 ],
 "Contact Email": [
  "krzysztof.senderak@uwr.edu.pl"
 ],
 "Organization": [
  "University of Wrocław"
 ],
 "Elevation": 2.83,
 "Coordinates": "POINT (14.50072 77.56511)",
 "Observed Properties": [
  "CRYOSPHERE>FROZEN GROUND>PERMAFROST>PERMAFROST TEMPERATURE"
 ],
