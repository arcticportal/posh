  "https://sios-svalbard.org/node/885",
  "https://www.mare-incognitum.no/krop/"
 ],
 "Site IDs": [
  885
 ],
 "Site Description": "Observatory moored with anchor weight. Bottom depth around 220 m. About 200 m of mooring line. Subsurface buoyancy at about 20 m water depth (hence the -20 m above sea level which refers to the start of the mooring line, not an actual instrument depth). Top 20 m left empty due to risk of ice scouring. Main &quot;photo&quot; is an example of a mooring diagram. Mooring setup is similar for other years, but does have changes in the details. Additional photos to illustrate some of the instrumentation.\r\nData is available at https://archive.sigma2.no/ split up according to years and sensor types.",
 "Metadata Created": "2020-07-16T12:23:10+00:00",
 "Metadata Updated": "2025-11-03T17:16:00+00:00",
 "Contact Name": [
  "Daniel Vogedes"
 ],
 "Contact Email": [
  "daniel.vogedes@uit.no"
 ],
 "Organization": [
  "UiT The Arctic University of Norway"
 ],
 "Elevation": -20.0,
 "Coordinates": "POINT (11.84129 78.956863)",
 "Observed Properties": [
  "OCEANS>SALINITY/DENSITY>CONDUCTIVITY",
  "OCEANS>OCEAN TEMPERATURE>WATER TEMPERATURE",
  "OCEANS>MARINE SEDIMENTS>SEDIMENTATION",
  "OCEANS>OCEAN ACOUSTICS>ACOUSTIC SCATTERING",
  "OCEANS>SALINITY/DENSITY>SALINITY",
  "OCEANS>OCEAN ACOUSTICS>AMBIENT NOISE",
  "OCEANS>OCEAN OPTICS>TURBIDITY"
 ],
