{
 "Source Catalog": "SIOS Observation Facility Catalogue",
 "Date Metadata Harvested": "2026-04-21T14:26:53+00:00",
 "POSDT ID": "be990601-ad2c-6098-6e97-207d70e57f3b",
 "Source Catalog URL": "https://sios-svalbard.org/sios-ri-catalogue",
 "Source Catalog Logo URL": "https://sios-svalbard.org/system/files/common/Logo-SIOS-ORIGINAL-rgb-simple_trimmed_small.png",
 "Country": [
  "Norway"
 ],
 "Networks": [
  "SIOS"
 ],
 "Site Name": "Bayelva station",
 "Web Links": [
  "https://sios-svalbard.org/node/766"
 ],
 "Site IDs": [
  766
 ],
 "Site Description": "Bayelva is situated on Brøggerhalvøya, due west of Ny-Ålesund. The catchment area is 30.9 km² of which 54 % is covered by the glaciers Austre Brøggerbreen and Vestre Brøggerbreen. In 1988 NVE initiated the discharge measurements and the river profile of Bayelva was stabilised by a large compound crump weir, designed and built by NVE. The cost was about 1 million Norwegian 1988-kroner. As the river profile is constantly changing there followed several problems, mainly due to the large amounts of sediment and ice build-up, but most were solved the following year.\r\nThe main problems with the runoff measurements are connected to ice and snow blocking the weir at the beginning of the snowmelt season (Fig. 14), leading to errors in calculation of river discharge. This is corrected for as far as possible, but the resulting accuracy is not known precisely.",
 "Metadata Created": "2020-04-15T15:39:58+00:00",
 "Metadata Updated": "2023-10-16T17:10:40+00:00",
 "Contact Name": [
  "Harald Songe"
 ],
 "Contact Email": [
  "haso@nve.no"
 ],
 "Organization": [
  "Norwegian Water Resources and Energy Directorate"
 ],
 "Elevation": 12.0,
 "Coordinates": "POINT (11.835 78.9325)",
 "Observed Properties": [
  "TERRESTRIAL HYDROSPHERE>SURFACE WATER>SURFACE WATER PROCESSES/MEASUREMENTS>RUNOFF",
  "ATMOSPHERE>ATMOSPHERIC TEMPERATURE>SURFACE TEMPERATURE>AIR TEMPERATURE",
  "TERRESTRIAL HYDROSPHERE>WATER QUALITY/WATER CHEMISTRY>WATER CHARACTERISTICS>WATER TEMPERATURE",
  "TERRESTRIAL HYDROSPHERE>WATER QUALITY/WATER CHEMISTRY>WATER CHARACTERISTICS>CONDUCTIVITY",
  "TERRESTRIAL HYDROSPHERE>WATER QUALITY/WATER CHEMISTRY>SOLIDS>SUSPENDED SOLIDS",
  "TERRESTRIAL HYDROSPHERE>WATER QUALITY/WATER CHEMISTRY>WATER CHARACTERISTICS>ORGANIC MATTER"
 ],
 "Project IDs": [
  1668,
  11353
 ],
 "Operating Status": "Operational",
 "Start Year": 1989,
 "Site Type": [
  "lake/river platform (fixed)"
 ]
}
