 "Country": [
  "Norway"
 ],
 "Networks": [
  "SIOS"
 ],
 "Site Name": "SPICE: Autonomous snow depth and glacier ablation station - HANSBREEN_1",
 "Web Links": [
  "https://sios-svalbard.org/node/152393",
  "https://crios.pl/"
 ],
 "Site IDs": [
  152393
 ],
 "Site Description": "Site Information https://a2photonicsensors.com/spice-snow-depth-real-time/\r\nSpice - IoT telemetric sensor for snowpack depth measurement.\r\nThe Spice sensor is a sonar-based sensor used for measuring the depth of the snowpack and monitoring its evolution during the winter season. The instrument performs temperature compensation so as to increase the accuracy of the measurement.\r\n\r\nCRIOS – Cryosphere Integrated Observation Network on Svalbard\r\nProject financed from the EEA Financial Mechanism 2014-2021 operated by the National Science Centre in Poland\r\nAgreement no. UMO-2022/43/7/ST10/00001 to a predefined project no. 2022/43/7/ST10/00001\r\nProject period: 08.09.2022 - 30.04.2024 (2029)",
 "Metadata Created": "2023-10-17T14:05:54+00:00",
 "Metadata Updated": "2023-10-17T15:49:57+00:00",
 "Contact Name": [
  "Michał Laska"
 ],
 "Contact Email": [
  "michal.laska@us.edu.pl"
 ],
 "Organization": [
  "University of Silesia in Katowice, Faculty of Natural Sciences, Institute of Earth Sciences"
 ],
 "Elevation": 175.0,
 "Coordinates": "POINT (15.61258 77.03532)",
 "Observed Properties": [
