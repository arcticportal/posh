{
 "Source Catalog": "SIOS Observation Facility Catalogue",
 "Date Metadata Harvested": "2026-04-21T14:26:53+00:00",
 "POSDT ID": "138169c7-5fd9-c9f1-0168-d141330fd776",
 "Source Catalog URL": "https://sios-svalbard.org/sios-ri-catalogue",
 "Source Catalog Logo URL": "https://sios-svalbard.org/system/files/common/Logo-SIOS-ORIGINAL-rgb-simple_trimmed_small.png",
 "Country": [
  "Norway"
 ],
 "Networks": [
  "SIOS"
 ],
 "Site Name": "Hansbreen mass balance stake network",
 "Web Links": [
  "https://sios-svalbard.org/node/751",
  "http://dx.doi.org/10.5904/wgms-fog-2018-11"
 ],
 "Site IDs": [
  751
 ],
 "Site Description": "Hansbreen surface mass balance monitoring programme started in 1988 on the initiative of the University of Silesia in Katowice. Since the beginning of XXi century programme is run under the umbrella of Polish Polar Station Hornsund owned by IG PAS. Hansbreen (HAB) is a medium-sized (56 km2) tidewater glacier located in the southern part of Wedel Jarlsberg Land, close to the Polish Polar Station in the fjord Hornsund. The glacier is ~16 km long, and elevations extend up to 550 m a.s.l. Surface mass balance monitoring started in 1988/89. Over the period of 1989-2017, the net surface mass balance has been continuously decreasing, with a mean of -0.36 m w.e. a-1. Frontal ablation, measured along the c. 1.5 km long ice cliff shows that mass loss by calving contributes substantially to the total mass loss (23-50%, i.e. additional ablation by an equivalent of c. -0.7 m w.e. a-1 on average) and varies interannually. SMB data are reported on a yearly basis to the World Glacier Monitoring Service.",
 "Metadata Created": "2020-03-30T18:58:11+00:00",
 "Metadata Updated": "2023-06-27T16:14:05+00:00",
 "Contact Name": [
  "Bartłomiej Luks"
 ],
 "Contact Email": [
  "luks@igf.edu.pl"
 ],
 "Organization": [
  "Institute of Geophysics, Polish Academy of Sciences"
 ],
 "Related Locations": [
  "Polish Polar Station"
 ],
 "Elevation": 250.0,
 "Coordinates": "POINT (15.63444 77.05627)",
 "Observed Properties": [
  "CRYOSPHERE>GLACIERS/ICE SHEETS>GLACIER MASS BALANCE/ICE SHEET MASS BALANCE"
 ],
 "Project IDs": [
  11500
 ],
 "Operating Status": "Operational",
 "Start Year": 1988,
 "Site Type": [
  "land platform (on ice)"
 ]
}
