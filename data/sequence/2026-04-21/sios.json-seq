{
 "Source Catalog": "SIOS Observation Facility Catalogue",
 "Date Metadata Harvested": "2026-04-21T14:26:53+00:00",
 "POSDT ID": "66613c39-764f-8fab-7a8f-271a4cb82083",
 "Source Catalog URL": "https://sios-svalbard.org/sios-ri-catalogue",
 "Source Catalog Logo URL": "https://sios-svalbard.org/system/files/common/Logo-SIOS-ORIGINAL-rgb-simple_trimmed_small.png",
 "Country": [
  "Norway"
 ],
 "Networks": [
  "SIOS"
 ],
 "Site Name": "Underwater Soundscape Station",
 "Web Links": [
  "https://sios-svalbard.org/node/152382",
  "https://www.researchinsvalbard.no/project/20000000-0000-0000-0000-000000007210/project-info"
 ],
 "Site IDs": [
  152382
 ],
 "Site Description": "The two acoustic moorings (Position and depth: 79°03.219’ N - 11°32.830’E - 72 m 78° 54.743’ N - 12° 24.308’ E - 79 m), operational since May 2014, is located in the Kongsfjorden. The first mooring was located in the inner part of Kongsfjorden at a distance of approximately 4 km from the Kronebreen glacier front, one of the largest fast-flowing and actively calving marine-terminating glacier streams of the Svalbard Islands; the second mooring was located at the mouth of the fjord, 27 km away from the Kronebreen glacier.\r\nThe fjord oceanography is regulated by the mixing of melting ice, cold Arctic waters, and warmer Atlantic water masses. Actively calving marine-terminating glaciers supply icebergs and freshwater input, which, together with other physical factors, determine the local species composition. Glacier fronts are upwelling areas for zooplankton and attract many top predators. However, climate-induced changes in oceanographic conditions are significantly altering Kongsfjorden habitats. Tidewater glaciers in Kongsfjorden are retreating, and recently, during the wintertime, sea ice formed only in the inmost parts of the fjord.",
 "Metadata Created": "2023-10-06T15:30:08+00:00",
 "Metadata Updated": "2023-10-10T15:49:54+00:00",
 "Contact Name": [
  "Giuseppa Buscaino"
 ],
 "Contact Email": [
  "giuseppa.buscaino@cnr.it"
 ],
 "Organization": [
  "National Research Council of Italy"
 ],
 "Elevation": -75.0,
 "Coordinates": "POLYGON ((11.54 79.05, 12.4 78.91))",
 "Observed Properties": [
  "OCEANS>OCEAN ACOUSTICS>AMBIENT NOISE"
 ],
 "Project IDs": [
  6616
 ],
 "Operating Status": "Operational",
 "Start Year": 2014,
 "Site Type": [
  "sea platform (fixed)"
 ]
}
