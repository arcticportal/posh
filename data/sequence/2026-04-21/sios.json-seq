 ],
 "Site IDs": [
  1071
 ],
 "Site Description": "The Polish Polar Station Hornsund (Institute of Geophysics, Polish Academy of Sciences) is running long-term hydrological and hydrochemical monitoring in the Hornsund region. Since 2010, monitoring has included water samples collection and discharge measurements within the non-glacierized Fuglebekken catchment (Fuglebekken brook). \r\nFuglebekken - brook running below Fugleberget along the western marginal moraine of Hansbreen to Isbjørnhamna, southernmost in Wedel Jarlsberg Land.",
 "Metadata Created": "2021-02-22T15:19:12+00:00",
 "Metadata Updated": "2023-06-28T16:02:08+00:00",
