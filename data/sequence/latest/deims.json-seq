{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-05-19T18:05:46+00:00",
 "POSDT ID": "663dac80-211d-4c19-a356-04ee0da0f0eb",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Hyytiälä SMEAR II LTER",
 "Web Links": [
  "https://deims.org/663dac80-211d-4c19-a356-04ee0da0f0eb",
  "https://www.helsinki.fi/en/research-stations/hyytiala-forestry-field-station",
  "https://www.atm.helsinki.fi/smear/smear-ii/",
  "https://www.helsinki.fi/en/inar",
  "https://smear.avaa.csc.fi/"
 ],
 "Site IDs": [
  "HYY-SMR",
  "https://deims.org/663dac80-211d-4c19-a356-04ee0da0f0eb"
 ],
 "Site Description": "The Hyytiälä SMEAR II site (Station for Measuring Ecosystem-Atmosphere Relations) is situated in the Hyytiälä Forestry Field Station of the University of Helsinki. The site consists is a managed, 60-yr old Scots pine forest stand. The main idea of SMEAR type infrastructures is continuous, comprehensive measurements of fluxes, storages and concentrations in the land ecosystem–atmosphere continuum. The forest measurements are operated continuously since 1996, and include e.g. leaf, stand and ecosystem scale measurements of greenhouse gases, volatile organic compounds, pollutants (e.g. O3, SO2, NOx) and aerosols, in addition to full suite of meteorological measurements. The biogeochemical cycles and vegetation–soil–atmosphere interactions are studied both experimentally and with long-term observations. The site has full carbon, water and nitrogen budgets made over 10 years, and it is a full ICOS ecosystem and atmospheric station. \r\nEcosystem and atmosphere measurements also exist nearby in two open oligotrophic fen sites and a humic lake with forested catchment. \r\nMost of the measured data can be retrieved from: https://smear.avaa.csc.fi/",
 "Images": [
  "https://deims.org/sites/default/files/photos/DSCF2884cc.jpg",
  "https://deims.org/sites/default/files/photos/DSCF2892c.jpg",
  "https://deims.org/sites/default/files/photos/DSCF2766_Detail_c.jpg",
