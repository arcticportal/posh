{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-05-19T18:05:46+00:00",
 "POSDT ID": "9fe5a5d1-ccc0-41ab-b555-5ca44da24cd8",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "TERENO - Wüstebach",
 "Web Links": [
  "https://deims.org/9fe5a5d1-ccc0-41ab-b555-5ca44da24cd8",
  "http://www.tereno.net"
 ],
 "Site IDs": [
  "DE-23-3-WUE",
  "https://deims.org/9fe5a5d1-ccc0-41ab-b555-5ca44da24cd8"
 ],
 "Site Description": "The Wüstebach catchment is located in the Eifel National Park and covers an area of 38.5 ha, with mean altitude of about 610 m. The geology is dominated by Devonian shale, which is covered by a periglacial solifluction layer of about 1–2 m thickness. Cambisols and Planosols have developed on the hillslopes, whereas Gleysols and Histosols have formed in the valley. The main soil texture is silty clay loam and the litter layer has a thickness between 0.5 and 14 cm. The mean annual precipitation is about 1200 mm. Norway Spruce planted in 1946 is the prevailing vegetation type. During late summer/early autumn of 2013, trees were almost completely removed in an area of 9 ha by the national park forest management in order to promote the natural regeneration of near-natural deciduous forest from spruce monoculture forest.",
 "Images": [
  "https://deims.org/sites/default/files/photos/tereno-wustebach-germany_4938.jpg",
  "https://deims.org/sites/default/files/photos/tereno-wustebach-germany_4932.jpg",
  "https://deims.org/sites/default/files/photos/tereno-wustebach-germany_1762.jpg",
  "https://deims.org/sites/default/files/photos/tereno-wustebach-germany_4936.jpg",
  "https://deims.org/sites/default/files/photos/tereno-wustebach-germany_4935.jpg",
  "https://deims.org/sites/default/files/photos/tereno-wustebach-germany_4933.jpg",
