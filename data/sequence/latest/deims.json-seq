{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-05-19T18:05:46+00:00",
 "POSDT ID": "1922e0d6-49a5-43fb-be93-d635bcf3d1ec",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "DMI Geophysical Observatory Qaanaaq",
 "Web Links": [
  "https://deims.org/1922e0d6-49a5-43fb-be93-d635bcf3d1ec"
 ],
 "Site IDs": [
  "https://deims.org/1922e0d6-49a5-43fb-be93-d635bcf3d1ec"
 ],
 "Site Description": "The DMI Geophysical Observatory Qaanaaq is located at the outer perimeter of the city of Qaanaaq in North West Greenland. The station connects different monitoring infrastructures in the region. Qaanaaq is a modern Greenlandic town located some distance away from the National Park in NOrth East Greenland and the nature reserve area in the Melville Bay to the south. Still, in particular marine activities are regulated in order not to disturb the Narwhal during summer. The city of Qaanaaq is located on a small peninsula at the northern flank of the deep Inglefield Fjord. A number of glaciers terminate into the fjord and the prominent North Water Winter Polynya reach to the mouth of the fjord. Qaanaaq connects a number of small settlements in the region.\r\n\r\nIn addition to classical meteorological measurements, it has served as a multidisciplinary Geophysical Observatory. Ongoing monitoring today includes infrasound and geomagnetism. In the latter years DMI has developed a participatory ocean and cryosphere monitoring program with offset in the station in collaboration with local hunters and with focus on the winter season. Monitoring data are presently only available from DMI data bases.",
 "Metadata Created": "2024-10-10T14:38:09+02:00",
 "Metadata Updated": "2024-10-10T14:39:49+02:00",
 "Organization": [
  "Danish Meteorological Institute (DMI)"
 ],
 "Country": [
  "Greenland"
 ],
 "Elevation": 16,
 "Coordinates": "POINT (-69.21725668 77.46482148)",
 "Networks": [
  "INTERACT"
 ],
 "Operating Status": "Operational",
 "Start Year": 1950
}
