 "Site Name": "DFG Exploratories for large-scale and long-term functional biodiversity research",
 "Web Links": [
  "https://deims.org/c30b3989-2703-4d99-87e2-273272558176",
  "http://www.biodiversity-exploratories.de/1/home/"
 ],
 "Site IDs": [
  "DFG Biodiversity Exploratories",
  "https://deims.org/c30b3989-2703-4d99-87e2-273272558176"
 ],
 "Site Description": "In the framework of an initiative to advance biodiversity research in Germany, we established three exemplary large-scale and long-term research sites (funded by the German Research Foundation). They are termed Biodiversity Exploratories, in contrast to mainly descriptive observatories. The exploratories sustain the scientific infrastructure to develop the intellectual framework needed to address critical questions about changes in biodiversity and to evaluate the impacts of those changes for ecosystem processes. Thus, in the exploratories biodiversity and ecosystem research will be merged at a large scale and with a long-term perspective.",
 "Images": [
  "https://deims.org/sites/default/files/photos/1_2008_AEG28_TrUebPl_Schafsweide%2520ungeduengt_Fellendorf_Martin%25281%2529.jpg",
