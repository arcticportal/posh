{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-05-19T18:05:46+00:00",
 "POSDT ID": "0ba2af64-d550-4cad-b778-a207e1b81776",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Suserup",
 "Web Links": [
  "https://deims.org/0ba2af64-d550-4cad-b778-a207e1b81776",
  "https://www.arcgis.com/apps/webappviewer/index.html?id=02775f59ec16420f8b5bb97311690b0c",
  "https://ign.ku.dk/english/about/research-infrastructure/",
  "https://www.stiftsor.dk/"
 ],
 "Site IDs": [
  "Suserup",
  "https://deims.org/0ba2af64-d550-4cad-b778-a207e1b81776"
 ],
 "Site Description": "Suserup Skov (19.2 ha) is an old growth temperate forest dominated by beech Fagus\r\nsylvatica, pedunculate oak Quercus robur, ash Fraxinus excelsior, wych elm Ulmus glabra,\r\nand black alder Alnus glutinosa, admixed with lime Tilia platyphyllos and sycamore maple Acer pseudoplatanus.\r\nKU/IGN-SNB, is a 19,2 ha old-growth beech-dominated mixed deciduous forests on western\r\nZealand owned by Sorø Academy. The forest use dates back to 4200 BC. A conservation act was placed on the\r\nforest in 1925 for biological and recreational purposes but allowing a minimum odd felling until the act was\r\nupdated in 1961 to a non-intervention forest. The forest is unique at European level in terms of nonintervention,\r\nand the long-term status as non-intervention forest has led to a unique steady state in biomass and\r\naccumulation of dead wood, thus serving as an important reference site for unmanaged temperate deciduous\r\nforest development. There are long-term data records of e.g. biomass, dead organic matter, soil, forest structure,\r\nflora and fungi starting from 1992. The platform is included in a series of paired managed and non-intervention\r\nforests for studies of forest structure, biodiversity and biogeochemistry in mature and old beech-dominated\r\nforests. Suserup Forest includes an ICP Forests level II plot (2001-).\r\nUpgrades: eLTER master sites: soil moisture content (TDR), remote sensing of growth and forest structure,\r\nLAI, NDVI (Lidar, camera), continuous plant phenology (web cam),and insect monitoring (optical sensors) as\r\nbiodiversity measures, ambient air quality and air pollution.",
 "Images": [
  "https://deims.org/sites/default/files/2022-03/IMG_20170614_124113.jpg"
 ],
 "Metadata Created": "2022-03-14T10:57:09+01:00",
