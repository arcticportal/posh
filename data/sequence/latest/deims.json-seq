 "Site Name": "Mukhrino field station of Yugra State University",
 "Web Links": [
  "https://deims.org/5eddca9f-d876-4e2b-b7c1-f7f13010a0ca",
  "https://mukhrinostation.com",
  "https://www.ugrasu.ru/education/institutions/rec-environmental-dynamics-and-global-climate-change-the-unesco-chair/polevaya-stantsiya-mukhrino/",
