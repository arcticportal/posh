{
 "Source Catalog": "DEIMS-SDR",
 "Date Metadata Harvested": "2026-05-19T18:05:45+00:00",
 "POSDT ID": "2b4ed6fa-ce83-4a75-af65-2cfa497ff5ba",
 "Source Catalog URL": "https://deims.org/search/sites",
 "Source Catalog Logo URL": "https://deims.org/docs/_images/logo_title_inline_height50.png",
 "Site Name": "Windermere",
 "Web Links": [
  "https://deims.org/2b4ed6fa-ce83-4a75-af65-2cfa497ff5ba",
  "https://ecn.ac.uk/",
  "https://eip.ceh.ac.uk/apps/lakes/detail.html?wbid=29233"
 ],
 "Site IDs": [
  "L04",
  "https://deims.org/2b4ed6fa-ce83-4a75-af65-2cfa497ff5ba"
 ],
 "Site Description": "UK ECN site.  Windermere is in NW England in the English Lake District, an area of great natural beauty and a tourist destination since the 18th century. The dominant geological structure of the Lake District is a dome of Paleozoic rocks formed by uplift in the Tertiary producing a radial drainage pattern later enhanced during the Pleistocene glaciation, with major lakes occupying bedrock basins in steep-sided, flat-floored valleys. Windermere is the largest natural lake in England with a surface area of 14.8km2 and altitude of only 40m. The lake is divided by a shallow sill into two basins; North Basin (NB) (surface area c. 8km2, maximum depth 64m) and South Basin (SB) (surface area c. 6.7km2, maximum depth 42m). Windermere (ECN site (2o58'W 54o23'N)), has a catchment of 180km2 draining into the lake via two main rivers, several small tarns (lakes) and streams. The catchment is mainly uplands, grazed by sheep all year but also used intensively for recreational purposes. The valley villages are major tourist destinations with consequent increases in sewage input to the lake. Over the past 50 years levels of dissolved reactive phosphorus in the lake have more than doubled, reaching their highest levels in the 1980s. The effluent discharged into SB from the main sewage works is now P-stripped to reduce the nutrient loading to the lake. The lake is a Site of Special Scientific Interest (SSSI), a source of potable water, a major recreational facility and a specialised fishery (for charr, Salvelinus alpinus). The Freshwater Biological Association and latterly the Centre for Ecology & Hydrology have had a laboratory on the shore of Windermere for over 50 years resulting in a large body of scientific literature based on Lake District lakes.",
 "Images": [
  "https://deims.org/sites/default/files/photos/14.7.2004_Windermere_near_Rawlinsons_Nab.JPG",
  "https://deims.org/sites/default/files/photos/27.4.2005_Windermere_steamer1.JPG",
  "https://deims.org/sites/default/files/photos/2010%252011%2520Windermere%2520looking%2520N%2520%25284%2529.JPG",
  "https://deims.org/sites/default/files/photos/2012%252003%2520SBAS%2520from%2520Gummer%2527s%2520How%2520%25281%2529.JPG",
  "https://deims.org/sites/default/files/photos/2016%2520March%252014th%2520Windermere%2520SBAS%2520%25283%2529.JPG",
  "https://deims.org/sites/default/files/photos/2016%2520Nov%252023%2520Windermere%2520passenger%2520boat.JPG"
 ],
 "Metadata Created": "2012-12-25T18:56:31+01:00",
