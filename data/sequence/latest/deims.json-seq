 "Site Name": "Plynlimon",
 "Web Links": [
  "https://deims.org/6d47f4ca-8621-49a4-8240-3021429d1db5",
  "https://www.ceh.ac.uk/our-science/monitoring-site/plynlimon-critical-zone-observatory",
  "https://catalogue.ceh.ac.uk/documents/91961a0f-3158-4d00-984d-91eb1e03e8bd#section-metadataQuality",
