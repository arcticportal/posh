# Schedule for the download -> sequence -> prune pipeline.
# Accepts standard 5-field cron, 7-field (with seconds), @weekly/@daily/@hourly,
# or @every <duration> (e.g. @every 168h). Times are in TZ (default UTC).
# Examples:
#   0 3 * * 1      Mon 03:00 UTC
#   0 0 * * 6      Sat 00:00 UTC
#   @weekly        Sun 00:00
#   @every 168h    every 7 days
POSH_CRON=0 3 * * 1

# How many dated download/sequence folders to keep (latest counts as one).
POSH_RETENTION=3

# Timezone supercronic schedules in. Default UTC.
TZ=UTC
